UIAPI.codeEncode = function(name)
    local out = {}
    local function put(v) out[#out + 1] = string.char(math.clamp(math.floor(v + 0.5), 0, 255)) end
    local function putS(str) put(#str); out[#out + 1] = str end
    local function putSpec(spec, src)
        for _, sp in ipairs(spec) do
            local v, lo, hi, kind = src[sp[1]], sp[2], sp[3], sp[4]
            if kind == "b" then
                put(v and 1 or 0)
            else
                v = math.clamp(tonumber(v) or lo, lo, hi)
                if kind == "i" then put(v - lo) else put((v - lo) / (hi - lo) * 255) end
            end
        end
    end
    local function putKey(k)
        local kv = k and k.Value or 0
        put(math.floor(kv / 256))
        put(kv % 256)
    end
    put(4)
    putS(name:sub(1, 24))
    local cnt = 0
    for _, c in ipairs(cats) do cnt += #(c.mods or {}) end
    put(cnt)
    for _, c in ipairs(cats) do
        for _, m in ipairs(c.mods or {}) do
            put(m.on and 1 or 0)
            put(m.value * 255)
            putKey(m.key)
            if m.settings then
                for _, st in ipairs(m.settings) do
                    if st.type == "toggle" then
                        put(m.opts[st.key] and 1 or 0)
                    elseif st.type == "slider" then
                        local v = math.clamp(tonumber(m.opts[st.key]) or st.min, st.min, st.max)
                        put((v - st.min) / (st.max - st.min) * 255)
                    elseif st.type == "choice" or st.type == "cycle" then
                        put(tonumber(m.opts[st.key]) or 1)
                    elseif st.type == "color" then
                        for _, ck in ipairs(st.keys) do put(tonumber(m.opts[ck]) or 255) end
                    end
                end
            end
        end
    end
    putSpec(UIAPI.specUI, UIC)
    putSpec(UIAPI.specBTN, BTN)
    putS(BTN.text or "")
    putKey(TOGGLE_KEY)
    put(ACC.R * 255)
    put(ACC.G * 255)
    put(ACC.B * 255)
    put((menuScale - 0.6) / 0.9 * 255)
    return table.concat(out)
end
UIAPI.codeDecode = function(bin)
    local pos = 1
    local function get()
        local b = bin:byte(pos)
        if not b then error("eof") end
        pos += 1
        return b
    end
    local function getS()
        local n = get()
        local str = bin:sub(pos, pos + n - 1)
        if #str ~= n then error("eof") end
        pos += n
        return str
    end
    local function getSpec(spec, dst)
        for _, sp in ipairs(spec) do
            local b, lo, hi, kind = get(), sp[2], sp[3], sp[4]
            if kind == "b" then dst[sp[1]] = b == 1
            elseif kind == "i" then dst[sp[1]] = lo + b
            else dst[sp[1]] = lo + b / 255 * (hi - lo) end
        end
    end
    local names = {}
    for _, it in ipairs(Enum.KeyCode:GetEnumItems()) do names[it.Value] = it.Name end
    local function getKey()
        local kv = get() * 256 + get()
        if kv == 0 then return false end
        return names[kv] or false
    end
    if get() ~= 4 then error("version") end
    local name = getS()
    local cnt = get()
    local have = 0
    for _, c in ipairs(cats) do have += #(c.mods or {}) end
    if cnt ~= have then error("count") end
    local d = {ui = {}, button = {match = true}}
    for _, c in ipairs(cats) do
        for _, m in ipairs(c.mods or {}) do
            d[c.name] = d[c.name] or {}
            local on, val = get(), get()
            local kk = getKey()
            local entry = {on = on == 1, value = val / 255, key = kk}
            if m.settings then
                local o = {}
                for _, st in ipairs(m.settings) do
                    if st.type == "toggle" then
                        o[st.key] = get() == 1
                    elseif st.type == "slider" then
                        local v = math.floor(st.min + get() / 255 * (st.max - st.min) + 0.5)
                        if st.step then v = math.floor(v / st.step + 0.5) * st.step end
                        o[st.key] = math.clamp(v, st.min, st.max)
                    elseif st.type == "choice" or st.type == "cycle" then
                        o[st.key] = math.clamp(get(), 1, #st.options)
                    elseif st.type == "color" then
                        for _, ck in ipairs(st.keys) do o[ck] = get() end
                    end
                end
                entry.opts = o
            end
            d[c.name][m.name] = entry
        end
    end
    getSpec(UIAPI.specUI, d.ui)
    getSpec(UIAPI.specBTN, d.button)
    d.button.text = getS()
    d.bindings = {menu = getKey()}
    local r, g, b = get(), get(), get()
    d.theme = {accent = {r = r, g = g, b = b}}
    d.layout = {scale = 0.6 + get() / 255 * 0.9}
    return name, d
end

