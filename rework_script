local function loadCfg(n)
    local json
    if hasFS then
        local ok, r = pcall(readfile, cfgPath(n))
        if not ok then return false end
        json = r
    else
        json = mem[n]
    end
    if not json then return false end
    local ok, d = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(d) ~= "table" then return false end
    if type(d.theme) == "table" then
        local accent = colorFromData(d.theme.accent or d.theme)
        if accent then
            ACC = accent
            H, S, V = Color3.toHSV(ACC)
            if applyColor then applyColor() end
        end
    end
    if type(d.layout) == "table" then
        menuX = tonumber(d.layout.x) or menuX
        menuY = tonumber(d.layout.y) or menuY
        menuScale = math.clamp(tonumber(d.layout.scale) or menuScale, 0.6, 1.5)
        main.Position = UDim2.new(0.5, menuX, 0.5, menuY)
        scale.Scale = menuScale
    end
    if type(d.names) == "table" then
        META.names = d.names
        if applyNamesData then applyNamesData(d.names, false) end
    end
    local proposedMenu, proposedKeys, validBindings = TOGGLE_KEY, {}, true
    local function loadedKey(raw, previous)
        if raw == nil then return previous end
        if raw == false then return nil end
        local key = bindingKey(raw)
        if not key then validBindings = false end
        return key
    end
    if type(d.bindings) == "table" then proposedMenu = loadedKey(d.bindings.menu, TOGGLE_KEY) end
    for _, c in ipairs(cats) do
        for _, m in ipairs(c.mods or {}) do
            local s = type(d[c.name]) == "table" and d[c.name][m.name]
            local key = m.key
            if type(s) == "table" then key = loadedKey(s.key, key) end
            proposedKeys[m] = key or false
            if key and key == proposedMenu then
                validBindings = false
            end
        end
    end
    if validBindings then
        TOGGLE_KEY = proposedMenu
        for m, key in pairs(proposedKeys) do m.key = key or nil end
        capture = nil
        refreshBindings()
    end
    FX.mute = true
    for _, c in ipairs(cats) do
        if c.mods and type(d[c.name]) == "table" then
            for _, m in ipairs(c.mods) do
                local s = d[c.name][m.name]
                if type(s) == "table" then
                    m.value = math.clamp(tonumber(s.value) or m.value, 0, 1)
                    if type(s.opts) == "table" and m.setOpts then pcall(m.setOpts, s.opts) end
                    local on = s.on == true
                    toggleModule(m, on)
                    if m.fn and m.on then pcall(m.fn, m) end
                end
            end
        end
    end
    FX.mute = false
    if type(d.ui) == "table" and UIAPI.apply then UIAPI.apply(d.ui) end
    if type(d.button) == "table" and BTNAPI.apply then BTNAPI.apply(d.button) end
    if type(d.hud) == "table" and UIAPI.hudSet then pcall(UIAPI.hudSet, d.hud) end
    if type(d.names) == "table" then
        if cats[currentTab] and cats[currentTab].mods then
            buildList(cats[currentTab].mods)
        elseif listMode == "names" and applyNamesData then
            buildNamesList()
        end
    end
    META.last = n
    saveMeta()
    return true
end

