applyNamesData = function(d, rebuild)
    if type(d.logo) == "string" and d.logo ~= "" then logoText = d.logo end
    if type(d.title) == "string" and d.title ~= "" then menuTitle = d.title end
    if type(d.sub) == "string" and d.sub ~= "" then menuSub = d.sub end
    if type(d.tabs) == "table" then
        for ci, v in pairs(d.tabs) do
            local i = tonumber(ci) or ci
            if cats[i] and type(v) == "string" and v ~= "" and UIAPI.catNameOk(i, v) then cats[i].name = v end
        end
    end
    if type(d.mods) == "table" then
        for ci, arr in pairs(d.mods) do
            local i = tonumber(ci) or ci
            local c = cats[i]
            if c and c.mods and type(arr) == "table" then
                for mi, v in pairs(arr) do
                    local m = modById(c, mi)
                    if m and type(v) == "string" and v ~= "" then m.name = v end
                end
            end
        end
    end
    logoL.Text = logoText
    titleL.Text = menuTitle
    subL.Text = menuSub
    for i, b in ipairs(tabBtns) do
        if cats[i] then b.Text = "   " .. cats[i].name end
    end
    if cats[currentTab] then title.Text = "Category: " .. cats[currentTab].name end
    if rebuild then
        if cats[currentTab] and cats[currentTab].mods then
            buildList(cats[currentTab].mods)
        elseif listMode == "names" then
            buildNamesList()
        end
    end
end

