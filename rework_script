    a.CornerRadius = UIC.sqSwitch and UDim.new(0, 5) or UDim.new(0.5, 0)
    b.CornerRadius = UIC.sqSwitch and UDim.new(0, 3) or UDim.new(0.5, 0)
end

UIAPI.applyShape = function()
    for i = #UIAPI.swl, 1, -1 do
        local pair = UIAPI.swl[i]
        if pair[1].Parent and pair[2].Parent then
            pair[1].CornerRadius = UIC.sqSwitch and UDim.new(0, 5) or UDim.new(0.5, 0)
            pair[2].CornerRadius = UIC.sqSwitch and UDim.new(0, 3) or UDim.new(0.5, 0)
        else
            table.remove(UIAPI.swl, i)
        end
    end
end

