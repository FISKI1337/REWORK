local function tw(obj, t, props, style, dir)
    local tween = TweenService:Create(obj, TweenInfo.new(t * UIAPI.speeds[UIC.speed][2], style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    tween:Play()
