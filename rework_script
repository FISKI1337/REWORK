local function setOpen(v)
    isOpen = v
    animToken += 1
    local my = animToken
    local mainPos = UDim2.new(0.5, menuX, 0.5, menuY)

    if v then
        if not backdrop.Visible then backdrop.BackgroundTransparency = 1 end
        local fresh = not main.Visible
        if fresh then
            scale.Scale = menuScale * 0.93
            main.Position = UDim2.new(0.5, menuX, 0.5, menuY + 18)
            main.GroupTransparency = 0
        end
        backdrop.Visible = true
        main.Visible = true

        local D = 0
        FX.vigIn()
        tw(backdrop, 0.12, {BackgroundTransparency = 1 - UIC.dim}, Enum.EasingStyle.Sine)
        tw(FX.blur, 0.15, {Size = UIC.blur}, Enum.EasingStyle.Sine)
        local function openMain()
            if my ~= animToken or not isOpen then return end
            tw(scale, 0.35, {Scale = menuScale}, Enum.EasingStyle.Quint)
            tw(main, 0.35, {Position = mainPos}, Enum.EasingStyle.Quint)
            main.GroupTransparency = 0
        end
        if D > 0 then task.delay(D, openMain) else openMain() end

        for _, p in ipairs({right, cfgPanel}) do
            if p.Visible then
                p.GroupTransparency = 0
                p.Position = UDim2.fromOffset(490, 10)
                task.delay(0.15 + D, function()
                    if my ~= animToken or not isOpen then return end
                    tw(p, 0.7, {GroupTransparency = 0, Position = UDim2.fromOffset(490, 10)}, Enum.EasingStyle.Quint)
                end)
            end
        end

        for i, row in ipairs(rows) do
            local g = rowGroup(row)
            if g then
                g.GroupTransparency = 0
                local fb = g:GetAttribute("fxBase")
                if fb then g.Size = fb end
            end
        end
    else
        token += 1
        rightAnimToken += 1
        cfgAnimToken += 1
        tw(backdrop, 0.35, {BackgroundTransparency = 1}, Enum.EasingStyle.Sine)

        tw(scale, 0.4, {Scale = menuScale * 0.8}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        tw(FX.blur, 0.4, {Size = 0}, Enum.EasingStyle.Sine)
        FX.vigOut()
        local closeTween = tw(main, 0.4, {Position = UDim2.new(0.5, menuX, 0.5, menuY + 40)}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        closeTween.Completed:Connect(function()
            if my == animToken and not isOpen then
                backdrop.Visible = false
                main.Visible = false
                main.Rotation = 0
            end
        end)
    end
end

do
    local function lum(c) return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B end
    local function btnColor() return ACC end
    local function inkFor(c) return lum(c) > 0.7 and Color3.fromRGB(20, 20, 23) or Color3.new(1, 1, 1) end
    local BASE = Color3.fromRGB(34, 34, 40)

    local root = new("Frame", {
        Name = "MenuButton", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 10,
        Size = UDim2.fromOffset(BTN.size, BTN.size), Position = UDim2.fromScale(BTN.fx, BTN.fy), Visible = false,
    }, gui)
    local rScale = new("UIScale", {Scale = 0}, root)
    local corners = {}

    for i, tr in ipairs({0.82, 0.9, 0.95}) do
        local sh = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 3), Size = UDim2.new(1, 6 * i, 1, 6 * i),
            BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = tr, BorderSizePixel = 0, ZIndex = 10, Active = false,
        }, root)
        table.insert(corners, new("UICorner", {}, sh))
    end

    local ring = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 11, Visible = false}, root)
    local ringCorner = new("UICorner", {}, ring)
    table.insert(corners, ringCorner)
    local ringStroke = new("UIStroke", {Color = ACC, Thickness = 2, Transparency = 1}, ring)

    local body = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = BASE, BackgroundTransparency = BTN.alpha, BorderSizePixel = 0, ZIndex = 12,
    }, root)
    table.insert(corners, new("UICorner", {}, body))
    new("UIGradient", {Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(120, 120, 126))}, body)
    local bStroke = new("UIStroke", {Color = ACC, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, body)
    new("UIGradient", {Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150))}, bStroke)

    local inner = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -8, 1, -8),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 12, Active = false,
    }, body)
    table.insert(corners, new("UICorner", {}, inner))
    new("UIStroke", {Color = Color3.new(1, 1, 1), Transparency = 0.92, Thickness = 1}, inner)

    local holder = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, ZIndex = 13, Active = false,
    }, body)
    local bars = {}
    local barCorners = {}
    for i = 1, 4 do
        bars[i] = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, ZIndex = 13, Active = false}, holder)
        barCorners[i] = new("UICorner", {CornerRadius = UDim.new(0.3, 0)}, bars[i])
    end

    local icon = new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = BTN.text, Font = FONT, TextSize = 24, TextColor3 = ACC, ZIndex = 13, Visible = false}, body)
    local hit = new("TextButton", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", AutoButtonColor = false, ZIndex = 14}, body)

    local function barLayout(open, t)
        local st = UIC.btnStyle
        local sz = BTN.size
        local col = open and inkFor(btnColor()) or btnColor()
        local function go(b, vis, props)
            b.Visible = vis
            if not vis then return end
            if t > 0 then
                local geo, tint = {}, {}
                for key, v in pairs(props) do
                    if key == "BackgroundColor3" or key == "BackgroundTransparency" then tint[key] = v else geo[key] = v end
                end
                tw(b, t, geo, Enum.EasingStyle.Back)
                tw(b, t, tint, Enum.EasingStyle.Quint)
            else
                for key, v in pairs(props) do b[key] = v end
            end
        end
        if st == 1 then
            local q = math.floor(sz * 0.17)
            local d = sz * 0.125
            local k = open and 0.5 or 1
            local spots = {{-1, -1}, {1, -1}, {-1, 1}, {1, 1}}
            for i, b in ipairs(bars) do
                go(b, true, {
                    Size = UDim2.fromOffset(open and q + 2 or q, open and q + 2 or q),
                    Position = UDim2.new(0.5, math.floor(spots[i][1] * d * k), 0.5, math.floor(spots[i][2] * d * k)),
                    Rotation = open and 45 or 0, BackgroundColor3 = col, BackgroundTransparency = 0,
                })
            end
        elseif st == 2 then
            local w = math.floor(sz * 0.4)
            local h = math.max(2, math.floor(sz * 0.065))
            local gap = math.floor(sz * 0.15)
            go(bars[1], true, {Size = UDim2.fromOffset(w, h), Position = UDim2.new(0.5, 0, 0.5, open and 0 or -gap), Rotation = open and 45 or 0, BackgroundColor3 = col, BackgroundTransparency = 0})
            go(bars[2], true, {Size = UDim2.fromOffset(open and 0 or math.floor(w * 0.7), h), Position = UDim2.fromScale(0.5, 0.5), Rotation = 0, BackgroundColor3 = col, BackgroundTransparency = open and 1 or 0})
            go(bars[3], true, {Size = UDim2.fromOffset(w, h), Position = UDim2.new(0.5, 0, 0.5, open and 0 or gap), Rotation = open and -45 or 0, BackgroundColor3 = col, BackgroundTransparency = 0})
            go(bars[4], false, {})
        elseif st == 3 then
            local dsz = math.floor(sz * (open and 0.34 or 0.24))
            go(bars[1], true, {Size = UDim2.fromOffset(dsz, dsz), Position = UDim2.fromScale(0.5, 0.5), Rotation = 0, BackgroundColor3 = col, BackgroundTransparency = 0})
            for i = 2, 4 do go(bars[i], false, {}) end
        else
            for i = 1, 4 do go(bars[i], false, {}) end
        end
    end

    local function style()
        local col = btnColor()
        local open = isOpen
        root.Size = UDim2.fromOffset(BTN.size, BTN.size)
        local r = UDim.new(BTN.round * 0.5, 0)
        for _, c in ipairs(corners) do c.CornerRadius = r end
        local st = UIC.btnStyle
        local textMode = st == 4
        icon.Visible = textMode
        holder.Visible = not textMode
        icon.Text = BTN.text ~= "" and BTN.text or "W"
        local br = UDim.new(st == 1 and 0.3 or (st == 2 and 1 or 0.5), 0)
        for _, bc in ipairs(barCorners) do bc.CornerRadius = br end
        icon.TextSize = math.floor(BTN.size * 0.45)
        bStroke.Color = col
        ringStroke.Color = col
        body.BackgroundColor3 = open and col or BASE
        body.BackgroundTransparency = open and 0.05 or BTN.alpha
        icon.TextColor3 = open and inkFor(col) or col
        barLayout(open, 0)
    end
    BTNAPI.style = style
    BTNAPI.refresh = function()
        style()
        if BTNAPI.syncPanel then BTNAPI.syncPanel() end
    end

    local function openAnim(v)
        local col = btnColor()
        tw(body, 0.4, {BackgroundColor3 = v and col or BASE, BackgroundTransparency = v and 0.05 or BTN.alpha})
        tw(icon, 0.4, {TextColor3 = v and inkFor(col) or col})
        barLayout(v, 0.45)
        if BTN.spin then
            holder.Rotation = v and -90 or 90
            tw(holder, 0.55, {Rotation = 0}, Enum.EasingStyle.Back)
            if icon.Visible then
                icon.Rotation = 0
                tw(icon, 0.6, {Rotation = 360}, Enum.EasingStyle.Back)
            end
        end
    end

    local function ripple()
        local rp = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 11}, root)
        new("UICorner", {CornerRadius = UDim.new(BTN.round * 0.5, 0)}, rp)
        local st = new("UIStroke", {Color = btnColor(), Thickness = 3, Transparency = 0.2}, rp)
        tw(rp, 0.6, {Size = UDim2.fromScale(1.9, 1.9)})
        tw(st, 0.6, {Transparency = 1, Thickness = 0.5}).Completed:Connect(function() rp:Destroy() end)
    end

    task.spawn(function()
        while gui.Parent do
            if BTN.pulse and BTN.show and not isOpen and root.Visible then
                ring.Visible = true
                ring.Size = UDim2.fromScale(1, 1)
                ringStroke.Transparency = 0.3
                tw(ring, 1.4, {Size = UDim2.fromScale(1.7, 1.7)}, Enum.EasingStyle.Sine)
                tw(ringStroke, 1.4, {Transparency = 1}, Enum.EasingStyle.Sine)
                task.wait(1.4)
                ring.Visible = false
                task.wait(1.1)
            else
                task.wait(0.4)
            end
        end
    end)

    local hover, down = false, false
    local function scaleTo()
        tw(rScale, 0.25, {Scale = down and 0.9 or (hover and 1.1 or 1)}, Enum.EasingStyle.Back)
        tw(bStroke, 0.25, {Thickness = hover and 3 or 2})
    end
    hit.MouseEnter:Connect(function() hover = true; scaleTo() end)
    hit.MouseLeave:Connect(function() hover = false; scaleTo() end)

    local pressed, dragged, pStart, pOrig = false, false, Vector2.zero, Vector2.zero
    hit.InputBegan:Connect(function(i)
        if not isPress(i) then return end
        pressed, dragged, down = true, false, true
        scaleTo()
        pStart = inputPos(i)
        local vs = gui.AbsoluteSize
        pOrig = Vector2.new(BTN.fx * vs.X, BTN.fy * vs.Y)
    end)
    UIS.InputChanged:Connect(function(i)
        if not pressed or not isMove(i) then return end
        local p = inputPos(i)
        if not dragged and (p - pStart).Magnitude > 6 then dragged = true end
        if dragged then
            local vs = gui.AbsoluteSize
            local m = BTN.size / 2 + 4
            local np = pOrig + (p - pStart)
            BTN.fx = math.clamp(np.X, m, vs.X - m) / vs.X
            BTN.fy = math.clamp(np.Y, m, vs.Y - m) / vs.Y
            root.Position = UDim2.fromScale(BTN.fx, BTN.fy)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if not isPress(i) or not pressed then return end
        pressed, down = false, false
        scaleTo()
        if not dragged then
            ripple()
            setOpen(not isOpen)
        end
    end)

    BTNAPI.setShown = function(v)
        if v then
            root.Visible = true
            tw(rScale, 0.55, {Scale = 1}, Enum.EasingStyle.Back)
        else
            tw(rScale, 0.3, {Scale = 0}, Enum.EasingStyle.Back, Enum.EasingDirection.In).Completed:Connect(function()
                if not BTN.show then root.Visible = false end
            end)
        end
    end
    BTNAPI.resetPos = function()
        BTN.fx, BTN.fy = 0.06, 0.2
        tw(root, 0.5, {Position = UDim2.fromScale(BTN.fx, BTN.fy)})
    end
    BTNAPI.apply = function(t)
        for _, k in ipairs({"show", "pulse", "match", "spin"}) do
            if type(t[k]) == "boolean" then BTN[k] = t[k] end
        end
        if type(t.text) == "string" then BTN.text = t.text:sub(1, (utf8.offset(t.text, 4) or #t.text + 1) - 1) end
        BTN.size = math.clamp(math.floor((tonumber(t.size) or BTN.size) + 0.5), 36, 100)
        BTN.round = math.clamp(tonumber(t.round) or BTN.round, 0, 1)
        BTN.alpha = math.clamp(tonumber(t.alpha) or BTN.alpha, 0, 0.9)
        BTN.hue = math.clamp(tonumber(t.hue) or BTN.hue, 0, 1)
        BTN.fx = math.clamp(tonumber(t.fx) or BTN.fx, 0, 1)
        BTN.fy = math.clamp(tonumber(t.fy) or BTN.fy, 0, 1)
        if not BTN.show and not TOGGLE_KEY then BTN.show = true end
        root.Position = UDim2.fromScale(BTN.fx, BTN.fy)
        BTNAPI.refresh()
        if BTN.show and not root.Visible then BTNAPI.setShown(true)
        elseif not BTN.show and root.Visible then BTNAPI.setShown(false) end
    end

    UIAPI.baseSetOpen = setOpen
    setOpen = function(v)
        UIAPI.baseSetOpen(v)
        openAnim(v)
    end

    style()
    if BTN.show then
        root.Visible = true
        tw(rScale, 0.7, {Scale = 1}, Enum.EasingStyle.Back)
    end
end

UIS.InputBegan:Connect(function(i, gp)
    if FX.dead then return end
    if gp or i.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local key = i.KeyCode
    if capture then
        if key == Enum.KeyCode.Escape then capture = nil
        elseif key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
            if capture == "menu" then
                TOGGLE_KEY = nil
                if not BTN.show then BTN.show = true; BTNAPI.setShown(true); BTNAPI.refresh() end
            else
                capture.key = nil
            end
            capture = nil
        elseif key ~= Enum.KeyCode.Unknown then
            local conflict
            if capture == "menu" then
                for _, c in ipairs(cats) do for _, m in ipairs(c.mods or {}) do if m.key == key then conflict = m break end end end
                if not conflict then TOGGLE_KEY = key; capture = nil end
            elseif TOGGLE_KEY == key then
            else
                capture.key = key
                capture = nil
            end
        end
        refreshBindings()
        return
    end
    if UIS:GetFocusedTextBox() then return end
    if key == TOGGLE_KEY then setOpen(not isOpen); return end
    local hits, allOn = {}, true
    for _, c in ipairs(cats) do
        for _, m in ipairs(c.mods or {}) do
            if m.key == key then
                table.insert(hits, m)
                if not m.on then allOn = false end
            end
        end
    end
    for _, m in ipairs(hits) do
        if m.on == allOn then toggleModule(m, not allOn) end
    end
end)

