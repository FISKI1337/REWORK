local function buildOpts(m)
    clearOpts()
    if not (m and m.settings) then return end
    optHolder = new("ScrollingFrame", {
        Position = UDim2.fromOffset(14, 76), Size = UDim2.new(1, -28, 1, -96),
        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 0,
        ScrollBarImageTransparency = 1,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 2,
    }, right)
    new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, optHolder)
    new("UIPadding", {PaddingBottom = UDim.new(0, 8)}, optHolder)
    local OFFC = Color3.fromRGB(51, 51, 56)
    local function fmt(s, v)
        if s.fmt then return s.fmt(v) end
        return tostring(v)
    end
    for si, s in ipairs(m.settings) do
        if s.show and not s.show(m.opts) then
            -- hidden for the current selection
        elseif s.type == "header" then
            local h = label(optHolder, s.label, 12, DIM, UDim2.new(), UDim2.new(1, 0, 0, 18))
            h.LayoutOrder = si
        elseif s.type == "toggle" then
            local row = new("Frame", {Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = Color3.fromRGB(26, 26, 29)}, optHolder)
            corner(row, 7)
            row.LayoutOrder = si
            local nameL = label(row, s.label, 12, TEXT, UDim2.fromOffset(10, 0), UDim2.new(1, -56, 1, 0))
            nameL.TextTruncate = Enum.TextTruncate.AtEnd
            local on = m.opts[s.key] == true
            local sw = new("Frame", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
                Size = UDim2.fromOffset(34, 18), BackgroundColor3 = on and ACC or OFFC,
            }, row)
            local dot = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12),
                BackgroundColor3 = on and inkColor() or Color3.new(1, 1, 1),
                Position = on and UDim2.new(1, -9, 0.5, 0) or UDim2.new(0, 9, 0.5, 0),
            }, sw)
            UIAPI.shapeSwitch(sw, dot)
            local btn = new("TextButton", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = ""}, row)
            btn.MouseButton1Click:Connect(function()
                local v = not m.opts[s.key]
                m.opts[s.key] = v
                tw(sw, 0.2, {BackgroundColor3 = v and ACC or OFFC})
                tw(dot, 0.2, {Position = v and UDim2.new(1, -9, 0.5, 0) or UDim2.new(0, 9, 0.5, 0)})
                tw(dot, 0.2, {BackgroundColor3 = v and inkColor() or Color3.new(1, 1, 1)})
                if s.set then pcall(s.set, v) end
            end)
        elseif s.type == "button" then
            local b = new("TextButton", {
                Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = ACC, Text = s.label, TextSize = 13, Font = FONT,
                TextColor3 = inkColor(), AutoButtonColor = true,
            }, optHolder)
            corner(b, 7)
            b.LayoutOrder = si
            b.MouseButton1Click:Connect(function()
                if s.action then pcall(s.action) end
            end)
        elseif s.type == "color" then
            local kr, kg, kb = s.keys[1], s.keys[2], s.keys[3]
            local row = new("Frame", {Size = UDim2.new(1, 0, 0, 150), BackgroundColor3 = Color3.fromRGB(26, 26, 29)}, optHolder)
            corner(row, 7)
            row.LayoutOrder = si
            label(row, s.label, 12, TEXT, UDim2.fromOffset(10, 6), UDim2.new(1, -70, 0, 14))
            local cur = Color3.fromRGB(tonumber(m.opts[kr]) or 255, tonumber(m.opts[kg]) or 255, tonumber(m.opts[kb]) or 255)
            local h, sat, val = Color3.toHSV(cur)
            local prev = new("Frame", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 6), Size = UDim2.fromOffset(40, 16), BackgroundColor3 = cur}, row)
            corner(prev, 4)
            local sv = new("Frame", {Position = UDim2.fromOffset(10, 28), Size = UDim2.new(1, -20, 0, 86), BackgroundColor3 = Color3.fromHSV(h, 1, 1), Active = true, ClipsDescendants = true}, row)
            corner(sv, 5)
            local wl = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, sv)
            new("UIGradient", {Transparency = NumberSequence.new(0, 1)}, wl)
            local bl = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0}, sv)
            new("UIGradient", {Rotation = 90, Transparency = NumberSequence.new(1, 0)}, bl)
            local svKnob = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, ZIndex = 3}, sv)
            corner(svKnob, 6)
            new("UIStroke", {Color = Color3.new(1, 1, 1), Thickness = 2}, svKnob)
            local hb = new("Frame", {Position = UDim2.fromOffset(10, 122), Size = UDim2.new(1, -20, 0, 16), BackgroundColor3 = Color3.new(1, 1, 1), Active = true}, row)
            corner(hb, 5)
            new("UIGradient", {Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)), ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
                ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)), ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
                ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)), ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
                ColorSequenceKeypoint.new(1, Color3.fromHSV(0, 1, 1)),
            })}, hb)
            local hKnob = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(6, 22), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 3}, hb)
            corner(hKnob, 3)
            new("UIStroke", {Color = Color3.fromRGB(20, 20, 23), Thickness = 1.5}, hKnob)
            local function refresh(write)
                local c = Color3.fromHSV(h, sat, val)
                prev.BackgroundColor3 = c
                sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                svKnob.Position = UDim2.fromScale(sat, 1 - val)
                hKnob.Position = UDim2.fromScale(h, 0.5)
                if write then
                    m.opts[kr] = math.floor(c.R * 255 + 0.5)
                    m.opts[kg] = math.floor(c.G * 255 + 0.5)
                    m.opts[kb] = math.floor(c.B * 255 + 0.5)
                    if s.set then pcall(s.set, c) end
                end
            end
            refresh(false)
            sv.InputBegan:Connect(function(i)
                if not isPress(i) then return end
                local function apply(x, y)
                    sat = math.clamp((x - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
                    val = 1 - math.clamp((y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
                    refresh(true)
                end
                optDragging = apply
                apply(i.Position.X, i.Position.Y)
            end)
            hb.InputBegan:Connect(function(i)
                if not isPress(i) then return end
                local function apply(x)
                    h = math.clamp((x - hb.AbsolutePosition.X) / math.max(hb.AbsoluteSize.X, 1), 0, 0.999)
                    refresh(true)
                end
                optDragging = apply
                apply(i.Position.X)
            end)
        elseif s.type == "cycle" or s.type == "choice" then
            local row = new("Frame", {Size = UDim2.new(1, 0, 0, 54), BackgroundColor3 = Color3.fromRGB(26, 26, 29)}, optHolder)
            corner(row, 7)
            row.LayoutOrder = si
            local nl = label(row, s.label, 12, TEXT, UDim2.fromOffset(10, 6), UDim2.new(1, -20, 0, 14))
            nl.TextTruncate = Enum.TextTruncate.AtEnd
            local n = #s.options
            local selectBtn = new("TextButton", {
                Position = UDim2.fromOffset(10, 26), Size = UDim2.new(1, -20, 0, 22),
                BackgroundColor3 = Color3.fromRGB(38, 38, 43), Text = "", TextSize = 12, Font = FONT,
                TextColor3 = TEXT, AutoButtonColor = false, TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 3,
            }, row)
            corner(selectBtn, 6)
            local function index()
                return math.clamp(math.floor(tonumber(m.opts[s.key]) or 1), 1, math.max(n, 1))
            end
            local function show()
                local k = index()
                selectBtn.Text = (n > 0 and tostring(s.options[k]) or "Select") .. "  ▾"
            end
            selectBtn.MouseEnter:Connect(function() tw(selectBtn, 0.15, {BackgroundColor3 = Color3.fromRGB(52, 52, 59)}) end)
            selectBtn.MouseLeave:Connect(function() tw(selectBtn, 0.2, {BackgroundColor3 = Color3.fromRGB(38, 38, 43)}) end)
            selectBtn.MouseButton1Click:Connect(function()
                if UIAPI.dropdownState and UIAPI.dropdownState.anchor == selectBtn then
                    UIAPI.closeDropdown()
                    return
                end
                UIAPI.openDropdown(right, selectBtn, s.options, index, function(k)
                    if m.opts[s.key] == k then
                        show()
                        return
                    end
                    m.opts[s.key] = k
                    if s.set then pcall(s.set, k) end
                    if s.type == "cycle" and m.refresh then pcall(m.refresh) end
                    if selectBtn.Parent then show() end
                end, {width = selectBtn.AbsoluteSize.X, maxHeight = 180, textSize = 12})
            end)
            show()
        elseif s.type == "slider" then
            local row = new("Frame", {Size = UDim2.new(1, 0, 0, 46), BackgroundTransparency = 1}, optHolder)
            row.LayoutOrder = si
            local nameL = label(row, s.label, 12, TEXT, UDim2.fromOffset(2, 0), UDim2.new(1, -60, 0, 16))
            nameL.TextTruncate = Enum.TextTruncate.AtEnd
            local cv = tonumber(m.opts[s.key]) or s.min
            local range = s.max - s.min
            local valL = label(row, fmt(s, cv), 12, DIM, UDim2.new(), UDim2.new(1, -2, 0, 16), Enum.TextXAlignment.Right)
            local frac = math.clamp((cv - s.min) / range, 0, 1)
            local hitA = new("Frame", {Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Active = true}, row)
            local trk = new("Frame", {Position = UDim2.new(0, 8, 0.5, -3), Size = UDim2.new(1, -16, 0, 6), BackgroundColor3 = Color3.fromRGB(38, 38, 43)}, hitA)
            corner(trk, 3)
            local fillF = trackAccent(new("Frame", {Size = UDim2.fromScale(frac, 1), BackgroundColor3 = ACC}, trk))
            corner(fillF, 3)
            local knobF = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(frac, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 2}, trk)
            corner(knobF, 7)
            new("UIStroke", {Color = Color3.fromRGB(20, 20, 23), Thickness = 2}, knobF)
            local function apply(x)
                local a = math.clamp((x - trk.AbsolutePosition.X) / math.max(trk.AbsoluteSize.X, 1), 0, 1)
                local v = math.floor(s.min + a * range + 0.5)
                if s.step then v = math.floor(v / s.step + 0.5) * s.step end
                v = math.clamp(v, s.min, s.max)
                if m.opts[s.key] ~= v then
                    m.opts[s.key] = v
                    valL.Text = fmt(s, v)
                    local f = (v - s.min) / range
                    tw(fillF, 0.08, {Size = UDim2.fromScale(f, 1)}, Enum.EasingStyle.Linear)
                    tw(knobF, 0.08, {Position = UDim2.fromScale(f, 0.5)}, Enum.EasingStyle.Linear)
                    if s.set then pcall(s.set, v) end
                end
            end
            hitA.InputBegan:Connect(function(i)
                if isPress(i) then optDragging = apply; apply(i.Position.X) end
            end)
        end
    end
end

local rightAnimToken = 0
local function showRight(m, animate)
    selected = m
    rightAnimToken += 1
    local my = rightAnimToken
    rNone.Visible = false
    if animate then
        right.GroupTransparency = 1
        right.Position = UDim2.fromOffset(500, 10)
        tw(right, 0.6, {GroupTransparency = 0, Position = UDim2.fromOffset(490, 10)}, Enum.EasingStyle.Quint)
    else
        right.GroupTransparency = 0
        right.Position = UDim2.fromOffset(490, 10)
    end
    if m then
        rTitle.Text = m.name
        rTitle.Position = UDim2.fromOffset(26, 12)
        rTitle.TextTransparency = 1
        tw(rTitle, 0.5, {Position = UDim2.fromOffset(0, 12), TextTransparency = 0}, Enum.EasingStyle.Quint)
        rState.Text = m.on and "Enabled" or "Disabled"; rState.Position = UDim2.fromOffset(0, 44)
        rState.TextTransparency = 1
        tw(rState, 0.5, {TextTransparency = 0})
        for _, o in ipairs(sliderItems) do o.Visible = true end
        fill.Size = UDim2.fromScale(0, 1); knob.Position = UDim2.fromScale(0, 0.5)
        tw(fill, 0.7, {Size = UDim2.fromScale(m.value, 1)}, Enum.EasingStyle.Quint)
        tw(knob, 0.7, {Position = UDim2.fromScale(m.value, 0.5)}, Enum.EasingStyle.Quint)
        local target = math.floor(m.value * 100)
        task.spawn(function()
            for k = 1, 12 do
                if rightAnimToken ~= my then return end
                sValue.Text = math.floor(target * k / 12) .. "%"
                task.wait(0.03)
            end
            if rightAnimToken == my then sValue.Text = target .. "%" end
        end)
        if m.settings then
            for _, o in ipairs(sliderItems) do o.Visible = false end
            buildOpts(m)
        else
            clearOpts()
            if not m.useValue then
                for _, o in ipairs(sliderItems) do o.Visible = false end
                rNone.Visible = true
            end
        end
    else
        clearOpts()
        rTitle.Text = "Settings"; rTitle.Position = UDim2.fromOffset(0, 90)
        rTitle.TextTransparency = 0
        rState.Text = ""
        rState.TextTransparency = 0
        for _, o in ipairs(sliderItems) do o.Visible = false end
    end
end

local capture, menuKeyButton
local function bindingKey(name)
    if type(name) ~= "string" then return nil end
    local ok, key = pcall(function() return Enum.KeyCode[name] end)
    if ok and key and key ~= Enum.KeyCode.Unknown and key ~= Enum.KeyCode.Escape and key ~= Enum.KeyCode.Backspace and key ~= Enum.KeyCode.Delete
        and not key.Name:match("^Button") and not key.Name:match("^Thumbstick") and not key.Name:match("^DPad") then
        return key
    end
end

local function shortKey(n)
    n = n:gsub("Left", "L"):gsub("Right", "R"):gsub("Control", "Ctrl"):gsub("Return", "Enter")
    return n
end

local function refreshBindings()
    for _, c in ipairs(cats) do
        for _, m in ipairs(c.mods or {}) do
            if m._keyBtn and m._keyBtn.Parent then
                local waiting = capture == m
                m._keyBtn.Text = waiting and "..." or (m.key and shortKey(m.key.Name) or "-")
                m._keyBtn.TextColor3 = waiting and ACC or (m.key and TEXT or DIM)
            end
        end
    end
    if menuKeyButton then
        menuKeyButton.Text = capture == "menu" and "Press key (Esc cancels)" or ("Menu key: " .. (TOGGLE_KEY and TOGGLE_KEY.Name or "None"))
    end
end

local function startCapture(target)
    local focused = UIS:GetFocusedTextBox()
    if focused then focused:ReleaseFocus() end
    capture = target
    refreshBindings()
end

local function toggleModule(m, state)
    local changed = m.on ~= state
    m.on = state
    if m._sw and m._sw.Parent then
        tw(m._sw, 0.25, {BackgroundColor3 = state and ACC or Color3.fromRGB(51, 51, 56)})
    end
    if m._dot and m._dot.Parent then
        tw(m._dot, 0.25, {Position = state and UDim2.new(1, -11, 0.5, 0) or UDim2.new(0, 11, 0.5, 0)}, Enum.EasingStyle.Back)
        tw(m._dot, 0.25, {BackgroundColor3 = state and inkColor() or Color3.new(1, 1, 1)})
        if changed then

            tw(m._dot, 0.12, {Size = UDim2.fromOffset(22, 15)}).Completed:Connect(function()
                if m._dot and m._dot.Parent then tw(m._dot, 0.3, {Size = UDim2.fromOffset(15, 15)}, Enum.EasingStyle.Back) end
            end)
        end
    end
    if changed and m._row and m._row.Parent then

        m._row.BackgroundColor3 = ACC:Lerp(PANEL, 0.7)
        tw(m._row, 0.7, {BackgroundColor3 = PANEL})
    end
    if m._nameLabel and m._nameLabel.Parent then tw(m._nameLabel, 0.2, {TextColor3 = state and TEXT or DIM}) end
    if m._bar and m._bar.Parent then tw(m._bar, 0.3, {BackgroundTransparency = state and 0 or 1}) end
    if selected == m then rState.Text = state and "Enabled" or "Disabled" end
    if changed then onToggle(m, state) end
end

local function makeRow(m, index)
    local row = new("CanvasGroup", {Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Color3.fromRGB(20, 20, 23), LayoutOrder = index, GroupTransparency = 1}, listHolder)
    corner(row, 10)
    m._row = row
    local bar = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(3, 20),
        BackgroundColor3 = ACC, BackgroundTransparency = m.on and 0 or 1, BorderSizePixel = 0,
    }, row)
    corner(bar, 2)
    m._bar = bar
    local nameL = label(row, m.name, 15, m.on and TEXT or DIM, UDim2.fromOffset(14, 0), UDim2.new(1, -128, 1, 0))
    m._nameLabel = nameL
    nameL.TextTruncate = Enum.TextTruncate.AtEnd
    local keyBtn = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -62, 0.5, 0), Size = UDim2.fromOffset(50, 22),
        BackgroundColor3 = Color3.fromRGB(32, 32, 37), Text = "", TextSize = 12, Font = FONT, TextColor3 = DIM,
        AutoButtonColor = false, ZIndex = 3, TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)
    corner(keyBtn, 6)
    local keyStroke = new("UIStroke", {Color = Color3.new(1, 1, 1), Transparency = 0.9}, keyBtn)
    m._keyBtn = keyBtn
    keyBtn.MouseEnter:Connect(function()
        tw(keyBtn, 0.15, {BackgroundColor3 = Color3.fromRGB(46, 46, 52)})
        tw(keyStroke, 0.15, {Transparency = 0.7})
    end)
    keyBtn.MouseLeave:Connect(function()
        tw(keyBtn, 0.15, {BackgroundColor3 = Color3.fromRGB(32, 32, 37)})
        tw(keyStroke, 0.15, {Transparency = 0.9})
    end)
    keyBtn.MouseButton1Click:Connect(function() startCapture(m) end)
    refreshBindings()
    local sw = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(40, 22),
        BackgroundColor3 = m.on and ACC or Color3.fromRGB(51, 51, 56)}, row)
    m._sw = sw
    local dot = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(15, 15), BackgroundColor3 = m.on and inkColor() or Color3.new(1, 1, 1),
        Position = m.on and UDim2.new(1, -11, 0.5, 0) or UDim2.new(0, 11, 0.5, 0)}, sw)
    m._dot = dot
    UIAPI.shapeSwitch(sw, dot)
    local btn = new("TextButton", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = ""}, row)
    btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton3 then startCapture(m) end
    end)

    btn.MouseEnter:Connect(function()
        tw(row, 0.2, {BackgroundColor3 = Color3.fromRGB(30, 30, 35)})
        if not m.on then tw(nameL, 0.2, {TextColor3 = TEXT}) end
    end)
    btn.MouseLeave:Connect(function()
        tw(row, 0.2, {BackgroundColor3 = Color3.fromRGB(20, 20, 23)})
        if not m.on then tw(nameL, 0.2, {TextColor3 = DIM}) end
    end)
    btn.MouseButton1Click:Connect(function()
        local mx = UIS:GetMouseLocation().X
        local clickedSwitch = mx >= sw.AbsolutePosition.X - 10
        if clickedSwitch then
            toggleModule(m, not m.on)
        end
        if selected ~= m then showRight(m) end
    end)
    return row
end

FX.popIn = function(g, delay, check)
    if not g:GetAttribute("fxBase") then g:SetAttribute("fxBase", g.Size) end
    local base = g:GetAttribute("fxBase")
    g.GroupTransparency = 1
    g.Size = UDim2.new(base.X.Scale * 0.8, base.X.Offset * 0.8, base.Y.Scale, base.Y.Offset)
    task.delay(delay, function()
        if not g.Parent or not check() then return end
        tw(g, 0.45, {GroupTransparency = 0}, Enum.EasingStyle.Quint)
