        local p = LM.props[prop]
        if not p then
            p = {orig = Lighting[prop], vals = {}, order = {}}
            LM.props[prop] = p
        end
        if p.vals[owner] == nil then table.insert(p.order, owner) end
        p.vals[owner] = val
    end
    function LM.release(owner)
        for prop, p in pairs(LM.props) do
            if p.vals[owner] ~= nil then
