local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end
local function isMove(i)
    return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end
local function inputPos(i)
    if i.UserInputType == Enum.UserInputType.Touch then
        return Vector2.new(i.Position.X, i.Position.Y + GuiService:GetGuiInset().Y)
    end
    return UIS:GetMouseLocation()
end

UIS.InputBegan:Connect(function(i)
    if not UIAPI.dropdownState or not isPress(i) then return end
    local p = inputPos(i)
    local function contains(o)
        if not (o and o.Parent) then return false end
        local a, s = o.AbsolutePosition, o.AbsoluteSize
        return p.X >= a.X and p.X <= a.X + s.X and p.Y >= a.Y and p.Y <= a.Y + s.Y
    end
    if not contains(UIAPI.dropdownState.menu) and not contains(UIAPI.dropdownState.anchor) then
        UIAPI.closeDropdown()
    end
end)
local function bindDrag(target, onStart, onMove)
    local held = false
    target.InputBegan:Connect(function(i)
        if isPress(i) then held = true; onStart(inputPos(i)) end
    end)
    UIS.InputChanged:Connect(function(i)
        if held and isMove(i) then onMove(inputPos(i)) end
    end)
    UIS.InputEnded:Connect(function(i)
        if isPress(i) then held = false end
    end)
end

