UIAPI.b64chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
UIAPI.b64e = function(data)
    local chars = UIAPI.b64chars
    return ((data:gsub(".", function(x)
        local r, b = "", x:byte()
        for k = 8, 1, -1 do r = r .. (b % 2 ^ k - b % 2 ^ (k - 1) > 0 and "1" or "0") end
        return r
    end) .. "0000"):gsub("%d%d%d?%d?%d?%d?", function(x)
        if #x < 6 then return "" end
        local c = 0
        for k = 1, 6 do c = c + (x:sub(k, k) == "1" and 2 ^ (6 - k) or 0) end
        return chars:sub(c + 1, c + 1)
    end) .. ({"", "==", "="})[#data % 3 + 1])
end
UIAPI.b64d = function(data)
    local chars = UIAPI.b64chars
    data = data:gsub("[^" .. chars .. "=]", "")
    return (data:gsub(".", function(x)
        if x == "=" then return "" end
        local r, f = "", (chars:find(x, 1, true) - 1)
        for k = 6, 1, -1 do r = r .. (f % 2 ^ k - f % 2 ^ (k - 1) > 0 and "1" or "0") end
        return r
    end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(x)
        if #x ~= 8 then return "" end
        local c = 0
        for k = 1, 8 do c = c + (x:sub(k, k) == "1" and 2 ^ (8 - k) or 0) end
        return string.char(c)
    end))
end

