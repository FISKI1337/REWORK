    UIAPI.lower = function(str)
        local ok, res = pcall(function()
            local out = {}
            for _, cp in utf8.codes(str) do
                if cp >= 0x410 and cp <= 0x42F then
                    cp += 32
                elseif cp == 0x401 then
                    cp = 0x451
                end
                out[#out + 1] = utf8.char(cp)
            end
            return table.concat(out)
        end)
        return (ok and res or str):lower()
    end

    UIAPI.find = function(q)
        local out = {}
        for _, e in ipairs(UIAPI.index) do
            local hay = UIAPI.lower(e.name) .. " " .. UIAPI.lower(e.kw or "")
