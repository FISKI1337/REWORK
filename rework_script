    local vis = {char = nil, folder = nil, parts = {}, p0 = nil, p1 = nil, beam = nil, highlight = nil}

    local function add(name, fn)
        local m = {id = name, name = name, on = false, value = 0.5, def = 0.5, fn = fn}
        table.insert(cats[1].mods, m)
        return m
    end

    local function randomSpot(center, char)
        local ignore = {char}
        local cam = workspace.CurrentCamera
        if cam then table.insert(ignore, cam) end
        rayParams.FilterDescendantsInstances = ignore
        for _ = 1, 8 do
            local angle = math.random() * math.pi * 2
            local dist = state.radius * (0.4 + 0.6 * math.random())
            local pos = center + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
            local ok, hit = pcall(function()
                return workspace:Raycast(pos + Vector3.new(0, 40, 0), Vector3.new(0, -120, 0), rayParams)
            end)
            if ok and hit then return hit.Position + Vector3.new(0, 3, 0) end
        end
        return center + Vector3.new(0, 0, state.radius)
    end

    local function clearGhost()
        if vis.folder then vis.folder:Destroy() end
        vis.folder, vis.char = nil, nil
        vis.p0, vis.p1, vis.beam, vis.highlight = nil, nil, nil, nil
        table.clear(vis.parts)
    end

    local function buildGhost(char)
        clearGhost()
