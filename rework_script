    }, main)
    local pts = {}
    local rnd = Random.new()
    local ptClock = 0

    local function ptColor()
        return ACC
    end
    local function restyle(pt)
        local px = math.max(1, math.floor(pt.s * UIC.ptSize + 0.5))
        pt.f.Size = UDim2.fromOffset(px, px)
        pt.f.BackgroundTransparency = math.clamp(1 - UIC.ptAlpha * pt.a, 0, 1)
        pt.f.BackgroundColor3 = ptColor()
        pt.cr.CornerRadius = UIC.ptShape == 1 and UDim.new(0.5, 0) or UDim.new(0, 1)
        pt.f.Rotation = UIC.ptShape == 3 and 45 or 0
    end
    local function spawnPt(initial)
        local f = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0, Active = false}, ptLayer)
        local pt = {
            f = f, cr = new("UICorner", {}, f), x = rnd:NextNumber(), y = initial and rnd:NextNumber() or -0.04,
            s = rnd:NextNumber(0.6, 1.4), a = rnd:NextNumber(0.5, 1), v = rnd:NextNumber(0.6, 1.4),
            ph = rnd:NextNumber(0, 6.28), fr = rnd:NextNumber(0.4, 1.2),
        }
        restyle(pt)
        return pt
    end
    UIAPI.ptRefresh = function()
        local want = UIC.pt and UIC.ptCount or 0
        while #pts < want do table.insert(pts, spawnPt(true)) end
        while #pts > want do
            local last = table.remove(pts)
            last.f:Destroy()
        end
        ptLayer.ZIndex = UIC.ptFront and 100 or 0
        for _, pt in ipairs(pts) do restyle(pt) end
        ptLayer.Visible = UIC.pt and main.Visible
    end
    local ptConn = RunService.Heartbeat:Connect(function(dt)
        local vis = UIC.pt and main.Visible
        ptLayer.Visible = vis
        if not vis then return end
        ptClock += dt
        local dir = UIC.ptDir == 2 and -1 or 1
        local base = 0.06 * UIC.ptSpeed * dir
        for _, pt in ipairs(pts) do
            pt.y += base * pt.v * dt
            if dir == 1 and pt.y > 1.04 then
                pt.y = -0.04
                pt.x = rnd:NextNumber()
            elseif dir == -1 and pt.y < -0.04 then
                pt.y = 1.04
                pt.x = rnd:NextNumber()
            end
            local sx = pt.x + math.sin(ptClock * pt.fr + pt.ph) * 0.05 * UIC.ptSway
            pt.f.Position = UDim2.fromScale(sx, pt.y)
        end
    end)
    gui.Destroying:Connect(function() ptConn:Disconnect() end)
    table.insert(syncers, function() UIAPI.ptRefresh() end)

