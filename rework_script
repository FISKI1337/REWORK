-- Shared select/dropdown state.  Module options and the app settings use the
-- same menu so opening one selector always closes the previous one.
UIAPI.dropdownState = nil
UIAPI.closeDropdown = function(immediate)
    local state = UIAPI.dropdownState
    UIAPI.dropdownState = nil
    if not (state and state.menu and state.menu.Parent) then return end
    if immediate then
        state.menu:Destroy()
        return
    end
    state.menu.Active = false
    local shift = state.openAbove and 8 or -8
    local closeTime = 0.2 * UIAPI.speeds[UIC.speed][2]
    tw(state.menu, 0.2, {
        Position = state.menu.Position + UDim2.fromOffset(0, shift),
        GroupTransparency = 1,
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    task.delay(closeTime + 0.03, function()
        if state.menu and state.menu.Parent then state.menu:Destroy() end
    end)
end

UIAPI.dropdownText = function(value)
    if type(value) == "table" then
        return tostring(value[1] or value.name or value.label or value[2] or "")
    end
    return tostring(value)
end

UIAPI.openDropdown = function(parent, anchor, options, getIndex, onSelect, cfg)
    UIAPI.closeDropdown(true)
    if not (parent and parent.Parent and anchor and anchor.Parent) or #options == 0 then return end

    cfg = cfg or {}
    local itemHeight = cfg.itemHeight or 26
    local maxHeight = cfg.maxHeight or 180
    local width = cfg.width or anchor.AbsoluteSize.X
    local contentHeight = #options * itemHeight + math.max(#options - 1, 0) * 4 + 12
    local menuHeight = math.min(maxHeight, contentHeight)
    local parentPos, anchorPos = parent.AbsolutePosition, anchor.AbsolutePosition
    local parentSize = parent.AbsoluteSize
    local x = anchorPos.X - parentPos.X
    local anchorY = anchorPos.Y - parentPos.Y
    local belowY = anchorY + anchor.AbsoluteSize.Y + 4
    local aboveY = anchorY - menuHeight - 4
    local openAbove = false

    width = math.min(width, math.max(parentSize.X - 16, 1))
    x = math.clamp(x, 8, math.max(8, parentSize.X - width - 8))
    local y = belowY
    local roomBelow = parentSize.Y - belowY - 8
    local roomAbove = anchorY - 8
    if roomBelow < menuHeight and roomAbove > roomBelow then
        y = aboveY
        openAbove = true
    end
    y = math.clamp(y, 8, math.max(8, parentSize.Y - menuHeight - 8))

    local menu = new("CanvasGroup", {
        Position = UDim2.fromOffset(x, y + (openAbove and 8 or -8)), Size = UDim2.fromOffset(width, menuHeight),
        BackgroundColor3 = PANEL, BackgroundTransparency = 0.02, BorderSizePixel = 0, ClipsDescendants = true,
        Active = true, GroupTransparency = 1, ZIndex = 30,
    }, parent)
    corner(menu, 8)
    new("UIStroke", {Color = Color3.new(1, 1, 1), Transparency = 0.86}, menu)
    local scroll = new("ScrollingFrame", {
        Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true,
        CanvasSize = UDim2.fromOffset(0, contentHeight),
        ScrollingDirection = Enum.ScrollingDirection.Y, ScrollBarThickness = 0,
        ScrollBarImageTransparency = 1, Active = true, ZIndex = 30,
    }, menu)
    new("UIPadding", {
        PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
        PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
    }, scroll)
    new("UIListLayout", {Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder}, scroll)

    local function currentIndex()
        local index = type(getIndex) == "function" and getIndex() or getIndex
        return math.clamp(math.floor(tonumber(index) or 1), 1, #options)
    end
    for index, value in ipairs(options) do
        local selectedOption = index == currentIndex()
        local option = new("TextButton", {
            Size = UDim2.new(1, 0, 0, itemHeight), BackgroundColor3 = selectedOption and ACC or Color3.fromRGB(32, 32, 37),
            BackgroundTransparency = 1, Text = UIAPI.dropdownText(value), TextTransparency = 1,
            TextSize = cfg.textSize or 12, Font = FONT,
            TextColor3 = selectedOption and inkColor() or TEXT, TextTruncate = Enum.TextTruncate.AtEnd,
            AutoButtonColor = false, LayoutOrder = index, ZIndex = 31,
        }, scroll)
        corner(option, 6)
        option.MouseEnter:Connect(function()
            tw(option, 0.12, {BackgroundColor3 = index == currentIndex() and ACC or HOVER})
        end)
        option.MouseLeave:Connect(function()
            tw(option, 0.16, {BackgroundColor3 = index == currentIndex() and ACC or Color3.fromRGB(32, 32, 37)})
        end)
        option.MouseButton1Click:Connect(function()
            if onSelect then pcall(onSelect, index) end
            UIAPI.closeDropdown()
        end)
        task.delay((index - 1) * 0.025, function()
            if option.Parent and menu.Parent then
                tw(option, 0.18, {BackgroundTransparency = 0, TextTransparency = 0}, Enum.EasingStyle.Quint)
            end
        end)
    end
    UIAPI.dropdownState = {menu = menu, anchor = anchor, openAbove = openAbove}
    tw(menu, 0.2, {
        Position = UDim2.fromOffset(x, y), GroupTransparency = 0,
    }, Enum.EasingStyle.Quint)
end

UIAPI.shapeSwitch = function(sw, dot)
    local a = new("UICorner", {}, sw)
