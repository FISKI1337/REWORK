                e.hl.FillColor = col
                e.hl.OutlineColor = col
                e.hl.FillTransparency = 1 - opts.fill / 100 * 0.85 * a
                e.hl.OutlineTransparency = 1 - 0.9 * a
            end
        end
    end))

