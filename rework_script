    local function toggle(panel, i, name, get, set)
        local f = rowAt(panel, i)
        reg(panel, name, f)
        label(f, name, 14, DIM, UDim2.fromOffset(12, 0), UDim2.new(1, -70, 1, 0))
        local sw = new("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(38, 20), BackgroundColor3 = OFF}, f)
        local dot = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = Color3.new(1, 1, 1), Position = UDim2.new(0, 10, 0.5, 0)}, sw)
        UIAPI.shapeSwitch(sw, dot)
        local function show(animate)
            local on = get()
            put(sw, {BackgroundColor3 = on and ACC or OFF}, animate)
            put(dot, {Position = on and UDim2.new(1, -10, 0.5, 0) or UDim2.new(0, 10, 0.5, 0), BackgroundColor3 = on and inkColor() or Color3.new(1, 1, 1)}, animate)
        end
        local hit = new("TextButton", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = ""}, f)
        hover(f, hit)
        hit.MouseButton1Click:Connect(function()
            set(not get())
            show(true)
        end)
        table.insert(syncers, function() show(false) end)
        show(false)
    end

    local function slider(panel, i, name, lo, hi, get, set, fmt, step)
        local f = rowAt(panel, i)
        reg(panel, name, f)
        label(f, name, 13, DIM, UDim2.fromOffset(12, 2), UDim2.fromOffset(120, 16))
        local val = label(f, "", 13, TEXT, UDim2.new(1, -72, 0, 2), UDim2.fromOffset(60, 16), Enum.TextXAlignment.Right)
        local tr = new("Frame", {Position = UDim2.fromOffset(12, 23), Size = UDim2.new(1, -24, 0, 5), BackgroundColor3 = Color3.fromRGB(38, 38, 43)}, f)
        corner(tr, 3)
        local fl = new("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = ACC}, tr)
        corner(fl, 3)
        local kn = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 2}, tr)
        corner(kn, 6)
        local hit = new("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 14), Size = UDim2.new(1, -24, 0, 20)}, f)
        local function show()
            local a = math.clamp((get() - lo) / (hi - lo), 0, 1)
            fl.Size = UDim2.fromScale(a, 1)
            kn.Position = UDim2.fromScale(a, 0.5)
            fl.BackgroundColor3 = ACC
            val.Text = fmt(get())
        end
        local function drag(pos)
            local a = math.clamp((pos.X - tr.AbsolutePosition.X) / tr.AbsoluteSize.X, 0, 1)
            local v = lo + (hi - lo) * a
            if step then v = math.floor(v / step + 0.5) * step end
            set(v)
            show()
        end
        bindDrag(hit, drag, drag)
        table.insert(syncers, show)
        show()
    end

    local function cycle(panel, i, name, getText, step, options)
        local f = rowAt(panel, i)
        reg(panel, name, f)
        label(f, name, 14, DIM, UDim2.fromOffset(12, 0), UDim2.new(1, -118, 1, 0))
        local pill = new("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(104, 24),
            BackgroundColor3 = Color3.fromRGB(32, 32, 37), Text = "", TextSize = 13, Font = FONT, TextColor3 = TEXT,
            AutoButtonColor = false, TextTruncate = Enum.TextTruncate.AtEnd,
        }, f)
        corner(pill, 7)
        local function optionList()
            local source = type(options) == "function" and options() or options or {}
            local result = {}
            for _, value in ipairs(source) do table.insert(result, UIAPI.dropdownText(value)) end
            return result
        end
        local function show()
            if pill.Parent then pill.Text = tostring(getText()) .. "  ▾" end
        end
        pill.MouseEnter:Connect(function() tw(pill, 0.15, {BackgroundColor3 = Color3.fromRGB(46, 46, 52)}) end)
        pill.MouseLeave:Connect(function() tw(pill, 0.15, {BackgroundColor3 = Color3.fromRGB(32, 32, 37)}) end)
        pill.MouseButton1Click:Connect(function()
            if UIAPI.dropdownState and UIAPI.dropdownState.anchor == pill then
                UIAPI.closeDropdown()
                return
            end
            local list = optionList()
            local current = 1
            local text = tostring(getText())
            for k, value in ipairs(list) do
                if value == text then current = k; break end
            end
            UIAPI.openDropdown(main, pill, list, current, function(k)
                if k ~= current then step(k - current) end
                show()
            end, {width = 104, maxHeight = 180, textSize = 13})
        end)
        table.insert(syncers, show)
        show()
    end

