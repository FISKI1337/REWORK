local optHolder, optDragging
local function clearOpts()
    UIAPI.closeDropdown(true)
    if optHolder then
        optHolder:Destroy()
        optHolder = nil
    end
end

UIS.InputChanged:Connect(function(i)
    if optDragging and isMove(i) then optDragging(i.Position.X, i.Position.Y) end
end)
