local function gunmodel_load(AssetId)
        local Key = tostring(AssetId)
        if GunModelCache[Key] then
                return GunModelCache[Key]:Clone()
        end
        local OK, Objects = pcall(function()
                return game:GetObjects("rbxassetid://" .. Key)
        end)
        if OK and Objects and #Objects > 0 then
                GunModelCache[Key] = Objects[1]
                return Objects[1]:Clone()
        end
        return nil
end

local function gunmodel_restore(Gun)
        if not Gun or not Gun:IsA("Tool") or Gun.Name ~= "Gun" then
                return
        end
        local Custom = Gun:FindFirstChild("CustomGunModel")
        if Custom then
                Custom:Destroy()
        end
        for _, Desc in ipairs(Gun:GetDescendants()) do
                if Desc:IsA("BasePart") then
                        Desc.Transparency = 0
                elseif Desc:IsA("Decal") or Desc:IsA("Texture") then
                        Desc.Transparency = 0
                end
        end
end

local function gunmodel_apply(Gun)
        if not Gun or not Gun:IsA("Tool") or Gun.Name ~= "Gun" then
                return
        end
        if not GunModelConfig.Enabled then
                gunmodel_restore(Gun)
                return
        end
        local Info = GUN_MODELS[GunModelConfig.Model]
        if not Info then
                return
        end
        local Char = LocalPlayer.Character
        if not Char or Gun.Parent ~= Char then
                return
        end
        local Hand = Char:FindFirstChild("RightHand") or Char:FindFirstChild("Right Arm")
        if not Hand then
                return
        end

        local Old = Gun:FindFirstChild("CustomGunModel")
        if Old then
                Old:Destroy()
        end

        local Model = gunmodel_load(Info.id)
        if not Model then
                return
        end
        Model.Name = "CustomGunModel"

        for _, Desc in ipairs(Model:GetDescendants()) do
                if Desc:IsA("Script") or Desc:IsA("LocalScript") then
                        Desc.Disabled = true
                end
        end

        local BasePart = Model:IsA("BasePart") and Model
                or Model.PrimaryPart
                or Model:FindFirstChild("Handle")
                or Model:FindFirstChildWhichIsA("BasePart", true)
        if not BasePart then
                Model:Destroy()
                return
        end

        for _, Desc in ipairs(Gun:GetDescendants()) do
                if Desc:IsA("BasePart") and not Desc:IsDescendantOf(Model) then
                        Desc.Transparency = 1
                elseif (Desc:IsA("Decal") or Desc:IsA("Texture")) and not Desc:IsDescendantOf(Model) then
                        Desc.Transparency = 1
                end
        end

        local function part_props(Part)
                Part.CanCollide = false
                Part.Anchored = false
                Part.Massless = true
        end
        if Model:IsA("BasePart") then
                part_props(Model)
        end
        for _, Desc in ipairs(Model:GetDescendants()) do
                if Desc:IsA("BasePart") then
                        part_props(Desc)
                end
        end

        local BaseCF
        if Char:FindFirstChild("UpperTorso") then
                BaseCF = CFrame.new(0, -0.25, -0.1) * CFrame.Angles(-1.5707963267948966, 0, 0)
        else
                BaseCF = CFrame.new(0, -1, -0.1) * CFrame.Angles(-1.5707963267948966, 0, 0)
        end
        local CF = Hand.CFrame * BaseCF * Info.rot * Info.pos
        if Model:IsA("Model") then
                Model:PivotTo(CF)
        elseif Model:IsA("BasePart") then
                Model.CFrame = CF
        end

        local WC = Instance.new("WeldConstraint")
        WC.Part0 = Hand
        WC.Part1 = BasePart
        WC.Parent = BasePart
        for _, Part in ipairs(Model:GetDescendants()) do
                if Part:IsA("BasePart") and Part ~= BasePart then
                        local W2 = Instance.new("WeldConstraint")
                        W2.Part0 = BasePart
                        W2.Part1 = Part
                        W2.Parent = Part
                end
        end

        Model.Parent = Gun
end

