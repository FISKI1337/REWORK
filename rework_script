UIAPI.combatRuntime = {
    desync = {
        real = nil, realVel = nil, fakeCF = nil, fakePos = nil,
        pause = 0, on = false, force = false, v2 = false,
        murdererPos = nil, lastFakeAt = 0, gunHold = false,
    },
    antiKill = {
        on = false, mode = 2, lastPos = {}, dangerUntil = 0,
        warned = false, savedCF = nil, oldCamType = nil,
        lobby = {model = nil, cf = nil, half = nil, at = 0},
    },
    spin = {on = false, speed = 10, direction = 2, hum = nil},
}

do
    local RunService = game:GetService("RunService")
    local state = UIAPI.combatRuntime.antiKill
    local desync = UIAPI.combatRuntime.desync
    local lp = Players.LocalPlayer

    local function add(name, fn)
        local m = {id = name, name = name, on = false, value = 0.5, def = 0.5, fn = fn}
        table.insert(cats[1].mods, m)
        return m
    end

    local function findTool(p, name)
        local char = p and p.Character
        local backpack = p and p:FindFirstChildOfClass("Backpack")
        return char and char:FindFirstChild(name) or backpack and backpack:FindFirstChild(name)
    end

    local function alive()
        local char = lp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then return hrp, hum, char end
    end

    local function inLobby(pos)
        local now = os.clock()
        local cache = state.lobby
        if now - cache.at > 1 or not cache.model or not cache.model.Parent then
            cache.at = now
            cache.model = workspace:FindFirstChild("Lobby") or workspace:FindFirstChild("RegularLobby")
            cache.cf, cache.half = nil, nil
            if cache.model then
                local ok, cf, size = pcall(function() return cache.model:GetBoundingBox() end)
                if ok then
                    cache.cf = cf
                    cache.half = size / 2 + Vector3.new(10, 30, 10)
                end
            end
        end
        if not cache.cf or not cache.half then return false end
        local rel = cache.cf:PointToObjectSpace(pos)
        return math.abs(rel.X) <= cache.half.X and math.abs(rel.Y) <= cache.half.Y and math.abs(rel.Z) <= cache.half.Z
    end

    local function pauseDesync(root)
        if desync.real and root and root.Parent then root.CFrame = desync.real end
        desync.real = nil
        desync.pause += 1
    end

    local function restore()
        local hrp, hum = alive()
        if hrp and state.savedCF then
            hrp.CFrame = state.savedCF
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
        if state.savedCF then desync.pause = math.max(0, desync.pause - 1) end
        state.savedCF = nil
        local cam = workspace.CurrentCamera
        if cam then
            cam.CameraType = state.oldCamType or Enum.CameraType.Custom
            if hum then cam.CameraSubject = hum end
        end
        state.oldCamType = nil
    end

    local m = add("Anti Kill All", function(mod)
        state.on = mod.on
        if not mod.on then
            desync.force, desync.v2, desync.murdererPos = false, false, nil
            state.dangerUntil, state.warned = 0, false
            table.clear(state.lastPos)
            if state.savedCF then restore() end
        end
    end)
    m.opts = {mode = 2}
    m.defOpts = {mode = 2}
    m.settings = {
        {type = "choice", key = "mode", label = "Mode", options = {"V1", "V2"}, set = function(v)
            state.mode = v
            desync.force, desync.v2, desync.murdererPos = false, false, nil
            if v ~= 1 and state.savedCF then restore() end
        end},
    }
    m.setOpts = function(o)
        if type(o) == "table" then
            local mode = o.mode
            if mode == "V1" then mode = 1 elseif mode == "V2" then mode = 2 end
            if type(mode) == "number" then
                state.mode = math.clamp(math.floor(mode + 0.5), 1, 2)
                m.opts.mode = state.mode
                desync.force, desync.v2, desync.murdererPos = false, false, nil
                if state.mode ~= 1 and state.savedCF then restore() end
            end
        end
        if selected == m then buildOpts(m) end
    end

    table.insert(UIAPI.kill, RunService.Heartbeat:Connect(function()
        if not state.on then
            desync.force, desync.v2, desync.murdererPos = false, false, nil
            if state.savedCF then restore() end
            return
        end

        local hrp, hum, char = alive()
        local now = os.clock()
        if not hrp or not hum or not char or findTool(lp, "Knife") or inLobby(hrp.Position) or char:FindFirstChild("Gun") then
            desync.force, desync.v2, desync.murdererPos = false, false, nil
            state.warned = false
            table.clear(state.lastPos)
            if state.savedCF then restore() end
            return
        end

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp then
                local c = p.Character
                local root = c and c:FindFirstChild("HumanoidRootPart")
                if root and findTool(p, "Knife") then
                    local pos = root.Position
                    if c:FindFirstChild("Knife") and (pos - hrp.Position).Magnitude < 20 then
                        state.dangerUntil = math.max(state.dangerUntil, now + 0.8)
                    end
                    local prev = state.lastPos[p]
                    if prev and (pos - prev).Magnitude > 25 and not inLobby(prev) and not inLobby(pos) then
                        state.dangerUntil = now + 2
                    end
                    state.lastPos[p] = pos
                else
                    state.lastPos[p] = nil
                end
            end
        end
        for p in pairs(state.lastPos) do
            if not p.Parent then state.lastPos[p] = nil end
        end

        local danger = now < state.dangerUntil
        if state.mode == 1 and danger and not state.warned then
            state.warned = true
            notify("Anti Kill All", "murderer is coming - you're untouchable")
        elseif not danger then
            state.warned = false
        end

        if state.mode == 2 then
            local murdererPos
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp and findTool(p, "Knife") then
                    local c = p.Character
                    local root = c and c:FindFirstChild("HumanoidRootPart")
                    if root then murdererPos = root.Position end
                end
            end
            desync.murdererPos = murdererPos
            desync.force, desync.v2 = true, true
            return
        end

        desync.force, desync.v2, desync.murdererPos = false, false, nil
        if danger then
            if not state.savedCF then
                pauseDesync(hrp)
                state.savedCF = hrp.CFrame
                local cam = workspace.CurrentCamera
                state.oldCamType = cam and cam.CameraType or nil
                if cam then cam.CameraType = Enum.CameraType.Scriptable end
            end
            hrp.CFrame = CFrame.new(state.savedCF.Position + Vector3.new(math.random(-30, 30), math.random(60, 90), math.random(-30, 30)))
            hrp.AssemblyLinearVelocity = Vector3.zero
        elseif state.savedCF then
            restore()
        end
    end))
    table.insert(UIAPI.kill, {Disconnect = function()
        state.on = false
        desync.force, desync.v2, desync.murdererPos = false, false, nil
        table.clear(state.lastPos)
        if state.savedCF then restore() end
    end})
end

do
