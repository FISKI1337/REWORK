        end
        applyOpts()
        if selected == droneModule then buildOpts(droneModule) end
    end
    droneModule.settings = {
        {type = "header", label = "Drone (enable = launch)"},
        {type = "choice", key = "kind", label = "Type", options = kinds, set = applyOpts},
        {type = "choice", key = "impact", label = "Impact", options = impacts, set = applyOpts},
        {type = "button", label = "Launch Drone", action = function()
            if droneBusy then return end
            applyOpts()
            task.spawn(launchDroneSafe)
        end},
    }
    applyOpts()
    droneModule.fn = function(m)
        if not m.on then return end
        if FX.mute then
            m.on = false
            task.defer(toggleModule, m, false)
            return
        end
        if droneBusy then return end
        task.spawn(launchDroneSafe)
        task.delay(1, function()
            if m.on and not droneBusy then toggleModule(m, false) end
        end)
    end
    gui.Destroying:Connect(function()
        pcall(emergencyCleanup)
    end)
end

setupDrone()
end

local function rowGroup(row)
    if row:IsA("CanvasGroup") then return row end
    return row:FindFirstChildWhichIsA("CanvasGroup")
end

do
    local W, Hh = main.Size.X.Offset, main.Size.Y.Offset
    local BASE_T = {}
    for i = 1, 10 do BASE_T[i] = 1 - 0.62 * (1 - (i - 0.5) / 10) ^ 2.4 end
    local N = #BASE_T
    local holder = new("Frame", {
        Name = "MenuGlow", AnchorPoint = Vector2.new(0.5, 0.5), Position = main.Position,
        Size = UDim2.fromOffset(W, Hh), BackgroundTransparency = 1, BorderSizePixel = 0,
        Visible = false, ZIndex = 0, Active = false,
    }, gui)
    local hScale = new("UIScale", {Scale = scale.Scale}, holder)
    local rings = {}
    for i = 1, N do
        local f = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(W, Hh), BackgroundTransparency = 1,
            BorderSizePixel = 0, Active = false, ZIndex = 1 + (N - i),
        }, holder)
        local cr = new("UICorner", {}, f)
        local st = new("UIStroke", {Color = ACC, Thickness = 1, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, f)
        rings[i] = {f = f, st = st, cr = cr, pad = 0, t = 1}
    end
    local function glowColor()
        return ACC
    end
    local function layout()
        local step = UIC.glowLen / N
        local k = math.clamp(UIC.glowBright * 2, 0, 2)
        for i, r in ipairs(rings) do
            r.pad = step * (i - 1)
            r.t = 1 - math.clamp((1 - BASE_T[i]) * k, 0, 1)
            r.cr.CornerRadius = UDim.new(0, 18 + r.pad)
            r.st.Thickness = math.max(step + 0.35, 0.5)
            r.st.Color = glowColor()
        end
    end
    layout()
    main:GetPropertyChangedSignal("Position"):Connect(function() holder.Position = main.Position end)
    scale:GetPropertyChangedSignal("Scale"):Connect(function() hScale.Scale = scale.Scale end)
    local tok, readyAt = 0, 0
    FX.vigIn = function()
        if not UIC.glow then return end
        tok += 1
        readyAt = os.clock() + 1.0
        layout()
        holder.Position = main.Position
        hScale.Scale = scale.Scale
        if not holder.Visible then
            for _, r in ipairs(rings) do
                r.f.Size = UDim2.fromOffset(W, Hh)
                r.st.Transparency = 1
            end
        end
        holder.Visible = true
        for _, r in ipairs(rings) do
            tw(r.f, 0.25, {Size = UDim2.fromOffset(W + r.pad * 2, Hh + r.pad * 2)}, Enum.EasingStyle.Quint)
            tw(r.st, 0.25, {Transparency = r.t}, Enum.EasingStyle.Quint)
        end
    end
    FX.vigOut = function()
        tok += 1
        local my = tok
        for _, r in ipairs(rings) do
            tw(r.f, 0.4, {Size = UDim2.fromOffset(W, Hh)}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            tw(r.st, 0.4, {Transparency = 1}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        end
        task.delay(0.45, function()
            if tok == my and not isOpen then holder.Visible = false end
        end)
    end
    FX.vigColor = function() layout() end
    FX.glowRefresh = function()
        if not isOpen then return end
        if UIC.glow then
            layout()
            holder.Position = main.Position
            holder.Visible = true
            for _, r in ipairs(rings) do
                r.f.Size = UDim2.fromOffset(W + r.pad * 2, Hh + r.pad * 2)
                r.st.Transparency = r.t
            end
            readyAt = os.clock() + 0.5
        else
            holder.Visible = false
        end
    end
    task.spawn(function()
        while gui.Parent do
            if isOpen and holder.Visible and os.clock() >= readyAt then
                for _, r in ipairs(rings) do tw(r.st, 1.6, {Transparency = math.min(1, r.t + 0.08)}, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut) end
                task.wait(1.6)
                if isOpen then
                    for _, r in ipairs(rings) do tw(r.st, 1.6, {Transparency = r.t}, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut) end
                    task.wait(1.6)
                end
            else
                task.wait(0.3)
            end
        end
    end)
end

