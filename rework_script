        local function fade_part(Part, Fade, Shrink)
                local Goal = Shrink and Vector3.new(Part.Size.X, 0, 0) or Part.Size
                TweenService:Create(Part, TweenInfo.new(Fade, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Goal, Transparency = 1 }):Play()
                task.delay(Fade + 0.05, function()
