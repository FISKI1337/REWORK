local function colorToData(c)
    return {r = math.floor(c.R * 255 + 0.5), g = math.floor(c.G * 255 + 0.5), b = math.floor(c.B * 255 + 0.5)}
end

local function colorFromData(v)
    if type(v) ~= "table" then return nil end
    local r = tonumber(v.r or v.R)
    local g = tonumber(v.g or v.G)
    local b = tonumber(v.b or v.B)
    if not r or not g or not b then return nil end
    return Color3.fromRGB(math.clamp(r, 0, 255), math.clamp(g, 0, 255), math.clamp(b, 0, 255))
end

local function contrastText()
    local lum = 0.299 * ACC.R + 0.587 * ACC.G + 0.114 * ACC.B
    return lum > 0.6 and Color3.fromRGB(20, 20, 23) or Color3.new(1, 1, 1)
end

local function inkColor()
    local lum = 0.299 * ACC.R + 0.587 * ACC.G + 0.114 * ACC.B
    return lum > 0.75 and Color3.fromRGB(20, 20, 23) or Color3.new(1, 1, 1)
end

