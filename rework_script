                local n = math.clamp(math.floor(tonumber(o.amount) or 300), 10, 900)
                local dir = Vector3.new(0, -1, 0)
                params.FilterDescendantsInstances = {folder, lp.Character}
                for i = 1, n do
                    local p = Instance.new("Part")
                    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
                    p.Material = Enum.Material.Neon
                    p.Parent = folder
                    local d = {part = p}
                    respawn(d, cam, true, dir)
                    drops[i] = d
                end
                folder.Parent = cam
                buildSplashes()
            end

            function E.stop()
                if conn then conn:Disconnect(); conn = nil end
                if folder then folder:Destroy() end
                if splashFolder then splashFolder:Destroy() end
                folder, splashFolder, drops = nil, nil, nil
            end
            function E.apply()
                if folder then build() end
            end

            local function step(dt)
                local cam = workspace.CurrentCamera
                if not cam or not folder then return end
                if folder.Parent ~= cam then folder.Parent = cam end
                if splashFolder and splashFolder.Parent ~= cam then splashFolder.Parent = cam end
                t += dt
                local fall = (tonumber(o.speed) or 6) * 12
                local wind = tonumber(o.wind) or 0
                local len = (tonumber(o.length) or 10) / 10
                local col = pickCol(o, t)
                local trans = math.clamp((tonumber(o.trans) or 35) / 100, 0, 1)
                local splash = o.splash
                local ripMax = (tonumber(o.ripple) or 14) / 10
                local c = cam.CFrame.Position
                local vel = Vector3.new(wind, -fall, wind * 0.3)
                local dir = vel.Unit
                params.FilterDescendantsInstances = {folder, splashFolder, lp.Character}
                local parts, cfs = {}, {}
                local landed = 0
                for i, d in ipairs(drops) do
                    d.pos = d.pos + vel * dt
                    local p = d.pos
                    if d.hit and p.Y <= d.hit.Y then
                        if splash and landed < 25 then
                            doSplash(d.hit, d.normal)
                            landed += 1
                        end
                        respawn(d, cam, false, dir)
                        p = d.pos
                    elseif p.Y < c.Y - 25 or math.abs(p.X - c.X) > R + 10 or math.abs(p.Z - c.Z) > R + 10 then
                        respawn(d, cam, false, dir)
                        p = d.pos
                    end
                    local part = d.part
                    part.Size = Vector3.new(0.05, 0.05, len)
                    part.Color = col
                    part.Transparency = trans
                    parts[i] = part
                    cfs[i] = CFrame.lookAt(p, p + dir)
                end
                workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)

                for _, r in ipairs(ripples) do
                    if r.active then
                        r.t += dt
                        local k = r.t / 0.55
                        if k >= 1 then
                            r.active = false
                            r.part.Transparency = 1
                        else
                            local dia = 0.25 + ripMax * k
                            r.part.Size = Vector3.new(0.03, dia, dia)
                            r.part.Color = col
                            r.part.Transparency = 0.35 + 0.65 * k
                            r.part.CFrame = CFrame.lookAt(r.pos + r.normal * 0.04, r.pos + r.normal) * CFrame.Angles(0, math.pi / 2, 0)
                        end
                    end
                end
                for _, s in ipairs(sparks) do
                    if s.pending then
                        s.pending = false
                        s.em.Color = ColorSequence.new(col)
                        s.em:Emit(4)
                    end
                end
            end
            function E.start()
                E.stop()
                build()
                conn = RunService.RenderStepped:Connect(step)
            end
            effects[1] = E
        end

