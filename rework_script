local function SAFarm_FlatDist(a, b)
        return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function SAFarm_PickCoin(pos, list, mpos)
        if not (SAFarm.avoidMurder and mpos) then
                return SAFarm_NearestCoin(pos, list)
        end
        local safe, sd = nil, math.huge
        local far, fd = nil, -1
        for _, v in ipairs(list) do
                local md = SAFarm_FlatDist(v.Position, mpos)
                if md > fd then fd = md far = v end
                if md >= SA_AVOID_DIST then
                        local d = (v.Position - pos).Magnitude
                        if d < sd then sd = d safe = v end
                end
        end
        if safe then return safe end
        if far and fd >= SA_AVOID_DIST * 0.6 then return far end
        return nil
end

local function SAFarm_CoinOkNow(v, mpos)
        if not SAFarm_CoinAvailable(v) then return false end
        if SAFarm.avoidMurder and mpos and SAFarm_FlatDist(v.Position, mpos) < SA_AVOID_DIST * 0.6 then return false end
        return true
end

local function SAFarm_AvoidSteer(cur, dest, mpos)
        if not (SAFarm.avoidMurder and mpos) then return dest end
        local dm = SAFarm_FlatDist(cur, mpos)
        if dm >= SA_AVOID_DIST then return dest end
        local away = Vector3.new(cur.X - mpos.X, 0, cur.Z - mpos.Z)
        if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
        away = away.Unit
        local want = Vector3.new(dest.X - cur.X, 0, dest.Z - cur.Z)
        local mag = want.Magnitude
        if mag < 0.1 then return dest end
        local weight = 1 + (1 - dm / SA_AVOID_DIST) * 2
        local blend = (want.Unit + away * weight)
        if blend.Magnitude < 0.1 then blend = away else blend = blend.Unit end
        local np = cur + blend * mag
        return Vector3.new(np.X, dest.Y, np.Z)
end

local function SAFarm_TouchTargets(coin)
        local list = {}
        local seen = {}
        local function add(p)
                if p and not seen[p] and p:IsA("BasePart") and p:FindFirstChildOfClass("TouchTransmitter") then
                        seen[p] = true
                        list[#list + 1] = p
                end
        end
        add(coin)
        for _, v in ipairs(coin:GetChildren()) do add(v) end
        local par = coin.Parent
        if par then
                if par:IsA("BasePart") then add(par) end
                for _, v in ipairs(par:GetChildren()) do add(v) end
        end
        if #list == 0 then list[1] = coin end
        return list
end

local function SAFarm_FireTouch(coin)
        if type(firetouchinterest) ~= "function" then return end
        if not coin or not coin.Parent then return end
        local now = os.clock()
        if now - SAFarm.lastTouch < 0.05 then return end
        SAFarm.lastTouch = now
        local hrp = SAFarm_HRP()
        if not hrp then return end
        for _, p in ipairs(SAFarm_TouchTargets(coin)) do
                pcall(firetouchinterest, hrp, p, 0)
                pcall(firetouchinterest, hrp, p, 1)
        end
end

local function SAFarm_Move(hrp, dest, dt)
        local dir = dest - hrp.Position
        local dist = dir.Magnitude
        local np = dest
        if dist > 0.1 then
                np = hrp.Position + dir.Unit * math.min(SA_FARM_SPEED * dt, dist)
        end
        local cf = CFrame.new(np)
        if SAFarm.mode == "Down" then
                cf = cf * CFrame.Angles(-math.pi * 0.5, 0, 0)
                SAFarm.wasDown = true
        end
        pcall(function()
                hrp.CFrame = cf
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
        end)
end

local SAFarmConn = RunService.Stepped:Connect(function(_, dt)
        if not SAFarm.enabled then return end
        if not SAFarm_CanFarm() then
                SAFarm.target = nil
                SAFarm.wasDown = false
                SAFarm_SetNoclip(false)
                return
        end
        local hrp = SAFarm_HRP()
        if not hrp then return end

        local list = {}
        for _, v in ipairs(SACollectionService:GetTagged("CoinVisual")) do
                if v and v.Parent and v:IsA("BasePart") then
                        if v:GetAttribute("Collected") then
                                local id = v:GetAttribute("CoinID")
                                if id and not SAFarm.collected[id] then
                                        SAFarm.collected[id] = true
                                        SAFarm.collectedCount = SAFarm.collectedCount + 1
                                end
                        elseif not v:GetAttribute("Delete") then
                                list[#list + 1] = v
                        end
                end
        end

        local function finish()
                SAFarm.target = nil
                SAFarm_Release()
                if not SAFarm.coinsDone then
                        SAFarm.coinsDone = true
                        SAFarm_UpdateHold()
                        if SAFarm.autoReset then
                                local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                                if hum then pcall(function() hum.Health = 0 end) end
                        end
                end
        end

        if SAFarm.sawCoins and SAFarm_CoinBagsFull() then
                finish()
                return
        end

        if #list > 0 then
                SAFarm.sawCoins = true
                if SAFarm.coinsDone then
                        SAFarm.coinsDone = false
                        SAFarm_UpdateHold()
                end

                local mhrp = SAFarm.avoidMurder and SAFarm_MurdererHRP() or nil
                local mpos = mhrp and mhrp.Position or nil

                if not SAFarm_CoinOkNow(SAFarm.target, mpos) then
                        SAFarm.target = SAFarm_PickCoin(hrp.Position, list, mpos)
                end

                if SAFarm.target then
                        SAFarm_SetNoclip(true)
                        local cpos = SAFarm.target.Position
                        SAFarm.downRefY = cpos.Y
                        local dest = cpos

                        if SAFarm.mode == "Down" then
                                local xz = SAFarm_FlatDist(hrp.Position, cpos)
                                local safeToRise = (not mpos) or SAFarm_FlatDist(hrp.Position, mpos) > SA_RISE_SAFE_DIST
                                if xz <= SA_DOWN_RISE_XZ and safeToRise then
                                        dest = cpos
                                        SAFarm_FireTouch(SAFarm.target)
                                else
                                        dest = Vector3.new(cpos.X, cpos.Y - SA_DOWN_DEPTH, cpos.Z)
                                end
                        elseif (cpos - hrp.Position).Magnitude <= 6 then
                                SAFarm_FireTouch(SAFarm.target)
                        end

                        dest = SAFarm_AvoidSteer(hrp.Position, dest, mpos)
                        SAFarm_Move(hrp, dest, dt)
                elseif mpos then
                        SAFarm_SetNoclip(true)
                        local away = Vector3.new(hrp.Position.X - mpos.X, 0, hrp.Position.Z - mpos.Z)
                        if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
                        away = away.Unit
                        local y = hrp.Position.Y
                        if SAFarm.mode == "Down" and SAFarm.downRefY then y = SAFarm.downRefY - SA_DOWN_DEPTH end
                        SAFarm_Move(hrp, hrp.Position + away * 40 + Vector3.new(0, y - hrp.Position.Y, 0), dt)
                end
        else
                SAFarm.target = nil
                SAFarm_Release()
                if SAFarm.sawCoins and not SAFarm.coinsDone and SAFarm.collectedCount > 0 then
                        finish()
                end
        end
end)

