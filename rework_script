                Part.Shape = Enum.PartType.Cylinder
                Part.Size = Vector3.new(Distance, Thickness, Thickness)
                Part.CFrame = CFrame.lookAt(From, To) * CFrame.new(0, 0, -Distance / 2) * CFrame.Angles(0, math.pi / 2, 0)
                Part.Parent = Workspace.Terrain
                return Part
