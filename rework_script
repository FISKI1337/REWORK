    -- ================= FAKE LAG =================
    do
        local fk = addMod("Fake Lag", {lag = 300, ghost = true, ghostAlpha = 72, gMat = 1, gOrigColor = true, gr = 237, gg = 140, gb = 148,
            gRefl = 0, gBody = true, gAcc = true, gGlow = true, gDepth = 1, gFillA = 92, gOutA = 55,
            gor = 237, gog = 140, gob = 148, gRainbow = false, gSize = 100, gFloat = 0})
        local choking = false
        local phaseEnd = 0
        -- Smooth mode: other players are sent a stale position, your own screen always uses the real one
        local fakeCF, realCF, applied, appliedHrp = nil, nil, false, nil
        local ghostModel
        local ghostHL
        local GMATS = {"None", "Neon", "ForceField"}
        local function gcol(p)
            local o = fk.opts
            return Color3.fromRGB(math.clamp(tonumber(o[p .. "r"]) or 255, 0, 255), math.clamp(tonumber(o[p .. "g"]) or 255, 0, 255), math.clamp(tonumber(o[p .. "b"]) or 255, 0, 255))
        end
        local function clearGhost()
            if ghostModel then
                ghostModel:Destroy()
                ghostModel = nil
            end
            ghostHL = nil
        end
        local function showGhost(cf)
            clearGhost()
            if not fk.opts.ghost or not cf then return end
            local o = fk.opts
            local character = LocalPlayer.Character
            if not character then return end
            local oldArchivable = character.Archivable
            character.Archivable = true
            local ok, clone = pcall(function() return character:Clone() end)
            character.Archivable = oldArchivable
            if not ok or not clone then return end

            clone.Name = "WataFakeLagGhost"
            local alpha = math.clamp((tonumber(o.ghostAlpha) or 72) / 100, 0, 1)
            local matName = GMATS[math.clamp(tonumber(o.gMat) or 1, 1, #GMATS)]
            local mat
            if matName ~= "None" then
                local mok, mv = pcall(function() return Enum.Material[matName] end)
                if mok then mat = mv end
            end
            local color = gcol("g")
            local showBody = o.gBody ~= false
            local showAcc = o.gAcc ~= false
            for _, child in ipairs(clone:GetDescendants()) do
                if child:IsA("Script") or child:IsA("LocalScript") or child:IsA("ModuleScript")
                    or child:IsA("Sound") or child:IsA("ParticleEmitter") or child:IsA("Trail") or child:IsA("Beam") then
                    child:Destroy()
                elseif child:IsA("Humanoid") then
                    child.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                    child.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
                    child.NameDisplayDistance = 0
                    child:Destroy()
                elseif child:IsA("BasePart") then
                    child.Anchored = true
                    child.CanCollide = false
                    child.CanTouch = false
                    child.CanQuery = false
                    child.CastShadow = false
                    child.Massless = true
                    local isAcc = child.Parent and child.Parent:IsA("Accessory")
                    if not showBody and not isAcc then
                        child.Transparency = 1
                    elseif isAcc and not showAcc then
                        child.Transparency = 1
                    else
                        child.Transparency = math.clamp(child.Transparency + alpha, 0, 1)
                        if mat then child.Material = mat end
                        if not o.gOrigColor then child.Color = color end
                        child.Reflectance = math.clamp((tonumber(o.gRefl) or 0) / 100, 0, 1)
                    end
                elseif child:IsA("Decal") or child:IsA("Texture") then
                    child.Transparency = showBody and math.clamp(child.Transparency + alpha, 0, 1) or 1
                elseif child:IsA("SpecialMesh") then
                    child.TextureId = (o.gOrigColor and child.TextureId) or ""
                end
            end
            local sz = (tonumber(o.gSize) or 100) / 100
            clone.Parent = workspace
            -- pivot by the root part so the pose and height match the real character exactly (the bounding-box pivot is off)
            local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
            if cloneRoot then clone.PrimaryPart = cloneRoot end
            clone:PivotTo(cf + Vector3.new(0, tonumber(o.gFloat) or 0, 0))
            if math.abs(sz - 1) > 0.001 then pcall(function() clone:ScaleTo(sz) end) end
            if o.gGlow ~= false then
                local outline = Instance.new("Highlight")
                outline.Name = "WataFakeLagGhostOutline"
                outline.Adornee = clone
                outline.DepthMode = (tonumber(o.gDepth) or 1) == 1 and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
                outline.FillColor = color
                outline.FillTransparency = math.clamp((tonumber(o.gFillA) or 92) / 100, 0, 1)
                outline.OutlineColor = gcol("go")
                outline.OutlineTransparency = math.clamp((tonumber(o.gOutA) or 55) / 100, 0, 1)
                outline.Parent = clone
                ghostHL = outline
            end
            ghostModel = clone
        end
        local function undoSmooth()
            if applied and appliedHrp and appliedHrp.Parent and realCF then appliedHrp.CFrame = realCF end
            applied, appliedHrp = false, nil
        end
        local function setChoke(on)
            choking = on
            if on then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                fakeCF = hrp and hrp.CFrame or nil
                showGhost(fakeCF)
            else
                undoSmooth()
                fakeCF = nil
                clearGhost()
            end
        end
        local function apply()
            if not fk.on then
                setChoke(false)
            else
                phaseEnd = 0
                if choking then showGhost(fakeCF) end
            end
        end
        local function restore() undoSmooth() end
        local c1 = RunService.Stepped:Connect(restore)
        -- restore before the camera script runs (priority First), otherwise the camera follows the stale position and jitters
        pcall(function() RunService:UnbindFromRenderStep("WataFakeLag") end)
        RunService:BindToRenderStep("WataFakeLag", Enum.RenderPriority.First.Value, restore)
        local c2 = function() pcall(function() RunService:UnbindFromRenderStep("WataFakeLag") end) end
        local c3 = RunService.Heartbeat:Connect(function()
            if not fk.on then return end
            if UIAPI.droneActive or UIAPI.combatRuntime.desync.real then
                if choking then setChoke(false) end
                return
            end
            local now = os.clock()
            if now >= phaseEnd then
                if choking then
                    setChoke(false)
                    phaseEnd = now + 0.05
                else
                    setChoke(true)
                    phaseEnd = now + (tonumber(fk.opts.lag) or 300) / 1000
                end
            end
            -- replicate the stale position for this frame only
            if choking and fakeCF then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    realCF = hrp.CFrame
                    hrp.CFrame = fakeCF
                    applied, appliedHrp = true, hrp
                end
            end
        end)
        local c4 = RunService.RenderStepped:Connect(function()
            if fk.opts.gRainbow and ghostModel then
                local col = Color3.fromHSV((os.clock() * 0.3) % 1, 0.8, 1)
                if ghostHL then ghostHL.FillColor = col; ghostHL.OutlineColor = col end
                if not fk.opts.gOrigColor then
                    for _, p in ipairs(ghostModel:GetDescendants()) do
                        if p:IsA("BasePart") then p.Color = col end
                    end
                end
            end
        end)
        table.insert(CleanupHandlers, c1)
        table.insert(CleanupHandlers, c2)
        table.insert(CleanupHandlers, c3)
        table.insert(CleanupHandlers, c4)
        table.insert(CleanupHandlers, function()
            setChoke(false)
            clearGhost()
        end)
        fk.settings = {
            {type = "header", label = "Fake Lag"},
            {type = "slider", key = "lag", label = "Lag time (ms)", min = 50, max = 6000, step = 10},
            {type = "toggle", key = "ghost", label = "Ghost position", set = function() if choking then showGhost(fakeCF) end end},
            {type = "header", label = "Ghost body"},
            {type = "cycle", key = "gMat", label = "Material", options = GMATS, set = function() if choking then showGhost(fakeCF) end end},
            {type = "toggle", key = "gOrigColor", label = "Original colors", set = function() if choking then showGhost(fakeCF) end end},
            {type = "color", label = "Ghost color", keys = {"gr", "gg", "gb"}, set = function() if choking then showGhost(fakeCF) end end},
            {type = "slider", key = "ghostAlpha", label = "Transparency", min = 0, max = 95, step = 1, fmt = function(v) return v .. "%" end, set = function() if choking then showGhost(fakeCF) end end},
            {type = "slider", key = "gRefl", label = "Reflectance", min = 0, max = 100, step = 5, fmt = function(v) return v .. "%" end, set = function() if choking then showGhost(fakeCF) end end},
            {type = "toggle", key = "gBody", label = "Show body", set = function() if choking then showGhost(fakeCF) end end},
            {type = "toggle", key = "gAcc", label = "Show accessories", set = function() if choking then showGhost(fakeCF) end end},
            {type = "slider", key = "gSize", label = "Size", min = 50, max = 200, step = 5, fmt = function(v) return v .. "%" end, set = function() if choking then showGhost(fakeCF) end end},
            {type = "slider", key = "gFloat", label = "Height offset", min = -5, max = 10, step = 1, set = function() if choking then showGhost(fakeCF) end end},
            {type = "header", label = "Ghost outline"},
            {type = "toggle", key = "gGlow", label = "Highlight", set = function() if choking then showGhost(fakeCF) end end},
            {type = "choice", key = "gDepth", label = "Visibility", options = {"Through walls", "Normal"}, set = function() if choking then showGhost(fakeCF) end end},
            {type = "color", label = "Outline color", keys = {"gor", "gog", "gob"}, set = function() if choking then showGhost(fakeCF) end end},
            {type = "slider", key = "gFillA", label = "Fill transparency", min = 0, max = 100, step = 1, fmt = function(v) return v .. "%" end, set = function() if choking then showGhost(fakeCF) end end},
            {type = "slider", key = "gOutA", label = "Outline transparency", min = 0, max = 100, step = 1, fmt = function(v) return v .. "%" end, set = function() if choking then showGhost(fakeCF) end end},
            {type = "toggle", key = "gRainbow", label = "Rainbow"},
        }
        bind(fk, apply)
    end

    -- ================= CAMERA DISTANCE =================
    do
        local cd = addMod("Camera Distance", {dist = 150})
        local orig
        local function apply()
            if cd.on then
                if not orig then orig = {max = LocalPlayer.CameraMaxZoomDistance, min = LocalPlayer.CameraMinZoomDistance} end
                LocalPlayer.CameraMaxZoomDistance = tonumber(cd.opts.dist) or 150
            elseif orig then
                LocalPlayer.CameraMaxZoomDistance = orig.max
                LocalPlayer.CameraMinZoomDistance = orig.min
                orig = nil
            end
        end
        -- some games reset the limit, keep it applied
        local conn = RunService.Heartbeat:Connect(function()
            if cd.on then
                local d = tonumber(cd.opts.dist) or 150
                if LocalPlayer.CameraMaxZoomDistance ~= d then LocalPlayer.CameraMaxZoomDistance = d end
            end
        end)
        table.insert(CleanupHandlers, conn)
        table.insert(CleanupHandlers, function() if orig then cd.on = false; apply() end end)
        cd.settings = {
            {type = "header", label = "Camera Distance (scroll out to zoom)"},
            {type = "slider", key = "dist", label = "Max distance", min = 20, max = 1000, step = 10},
        }
        bind(cd, apply)
    end

    -- ================= WALL CLIMB =================
    do
        local wc = addMod("Wall Climb", {speed = 30})
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.IgnoreWater = true
        local conn = RunService.Heartbeat:Connect(function()
            if not wc.on then return end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum or hum.Health <= 0 then return end
            local dir = hum.MoveDirection
            if dir.Magnitude < 0.1 then return end
            params.FilterDescendantsInstances = {char}
            local hit = Workspace:Raycast(hrp.Position, dir.Unit * 3, params)
            if hit and hit.Instance and hit.Instance.CanCollide and math.abs(hit.Normal.Y) < 0.5 then
                -- moving into a wall: go up along it
                local v = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(-hit.Normal.X * 4, tonumber(wc.opts.speed) or 30, -hit.Normal.Z * 4)
            end
        end)
        table.insert(CleanupHandlers, conn)
        wc.settings = {
            {type = "header", label = "Wall Climb (walk into a wall)"},
            {type = "slider", key = "speed", label = "Climb speed", min = 5, max = 100, step = 1},
        }
        bind(wc, function() end)
    end

    -- ================= ANTI FLING =================
    do
        local af = addMod("Anti Fling", {})
        local flingParts = {}
        local safeCFrame, safeTime = nil, 0
        local wasActive = false
        local function active() return af.on and not UIAPI.droneActive end
        local function restoreParts()
            for part in pairs(flingParts) do
                if part.Parent then part.CanCollide = true end
            end
            table.clear(flingParts)
        end
        local c1 = RunService.Stepped:Connect(function()
            if not active() then return end
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    for _, part in ipairs(p.Character:GetDescendants()) do
                        if part:IsA("BasePart") and part.CanCollide then
                            flingParts[part] = true
                            part.CanCollide = false
                        end
                    end
                end
            end
        end)
        local c2 = RunService.Heartbeat:Connect(function()
            local on = active()
            if on ~= wasActive then
                wasActive = on
                if not on then restoreParts() end
            end
            if not on then return end
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local v, w = hrp.AssemblyLinearVelocity, hrp.AssemblyAngularVelocity
            if v.Magnitude > 200 or w.Magnitude > 60 then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.AssemblyLinearVelocity = Vector3.zero
                        part.AssemblyAngularVelocity = Vector3.zero
                    end
                end
                if safeCFrame then hrp.CFrame = safeCFrame end
            elseif os.clock() - safeTime > 0.1 then
                safeCFrame, safeTime = hrp.CFrame, os.clock()
            end
        end)
        table.insert(CleanupHandlers, c1)
        table.insert(CleanupHandlers, c2)
        table.insert(CleanupHandlers, restoreParts)
        af.fn = function() if not af.on then restoreParts() end end
    end
end
setupPlayerPort()
end


