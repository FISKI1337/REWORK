        local hit = new("TextButton", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 1}, info)
        local tok, asking = 0, false
        local function ask(on)
            tok += 1
            asking = on
            local my = tok
            if on then
                conf.Position = UDim2.fromScale(0.5, 0)
                conf.Visible = true
                tw(info, 0.4, {Position = UDim2.fromScale(-0.5, 0)}, Enum.EasingStyle.Quint)
                tw(conf, 0.4, {Position = UDim2.fromScale(0, 0)}, Enum.EasingStyle.Quint)
                task.delay(4, function()
                    if tok == my then ask(false) end
                end)
            else
                tw(info, 0.4, {Position = UDim2.fromScale(0, 0)}, Enum.EasingStyle.Quint)
                tw(conf, 0.4, {Position = UDim2.fromScale(0.5, 0)}, Enum.EasingStyle.Quint)
                task.delay(0.45, function()
                    if tok == my then conf.Visible = false end
                end)
            end
        end
        local function look(over)
            if asking then return end
            tw(f, 0.2, {BackgroundColor3 = over and HOVER or ROW})
            tw(bar, 0.3, {Size = UDim2.fromOffset(over and 4 or 3, over and 36 or 24)}, Enum.EasingStyle.Quint)
            tw(info, 0.3, {Position = UDim2.fromOffset(over and 4 or 0, 0)}, Enum.EasingStyle.Quint)
        end
        hit.MouseEnter:Connect(function() look(true) end)
        hit.MouseLeave:Connect(function()
            look(false)
            tw(sc, 0.15, {Scale = 1}, Enum.EasingStyle.Quint)
        end)
        hit.MouseButton1Down:Connect(function() tw(sc, 0.1, {Scale = 0.97}, Enum.EasingStyle.Quint) end)
        hit.MouseButton1Up:Connect(function() tw(sc, 0.25, {Scale = 1}, Enum.EasingStyle.Back) end)
