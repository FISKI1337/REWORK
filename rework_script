    local presetList = {"Original"}
    for _, n in ipairs(SH.order) do table.insert(presetList, n) end
    for _, p in ipairs(SH.packs) do table.insert(presetList, p.name) end

    local shMain = addMod("Shader", {preset = 1, strength = 100, quality = 1, tech = 1})
    shMain.specs = {}

    -- a manual setting overrides the look only when its value differs from the default, so untouched rows never fight the preset
    local function pushSub(m)
        for _, it in ipairs(m.specs) do
            local k, v, changed = it.key, nil, false
            if it.kind == "toggle" then
                v = m.opts[k] == true
                changed = m.opts[k] ~= m.defOpts[k]
            elseif it.kind == "slider" then
                v = (tonumber(m.opts[k]) or 0) / (it.scale or 1)
                changed = m.opts[k] ~= m.defOpts[k]
            elseif it.kind == "color" then
                v = Color3.fromRGB(tonumber(m.opts[k .. "_r"]) or 255, tonumber(m.opts[k .. "_g"]) or 255, tonumber(m.opts[k .. "_b"]) or 255)
                changed = m.opts[k .. "_r"] ~= m.defOpts[k .. "_r"] or m.opts[k .. "_g"] ~= m.defOpts[k .. "_g"] or m.opts[k .. "_b"] ~= m.defOpts[k .. "_b"]
            elseif it.kind == "cycle" then
                v = it.options[idx(m.opts[k], #it.options)]
                changed = m.opts[k] ~= m.defOpts[k]
            end
            if changed and v ~= nil then SH[k] = v end
        end
    end
    local function rebuild()
        SH.batch = true
        for k, v in pairs(SH.defaults) do
            if not KEEP[k] then SH[k] = v end
        end
        local name = presetList[idx(shMain.opts.preset, #presetList)]
        local look = lookByName[name]
        SH.preset = name
        if look then
            for k, v in pairs(look.values) do SH[k] = v end
        end
        pushSub(shMain)
        SH.strength = tonumber(shMain.opts.strength) or 100
        SH.quality = ({"Full", "Light"})[idx(shMain.opts.quality, 2)]
        SH.tech = ({"Future", "ShadowMap", "Voxel", "Game"})[idx(shMain.opts.tech, 4)]
        SH.batch = false
        if SH.on then SH.request() end
    end
    local function shApply()
        if shMain.on then
            rebuild()
            if not SH.on then SH.setEnabled(true) end
        else
            if SH.on then SH.setEnabled(false) end
        end
    end
    shMain.settings = {
        {type = "header", label = "Shader"},
        {type = "cycle", key = "preset", label = "Shader", options = presetList},
    }
    bind(shMain, shApply)
    table.insert(cleanups, function() pcall(SH.setEnabled, false) end)

    local function makeSub(name, spec)
        local settings = {{type = "header", label = name}}
        for _, it in ipairs(spec) do
            local d = SH.defaults[it.key]
            local function put(k, v) shMain.opts[k] = v; shMain.defOpts[k] = v end
            if it.kind == "toggle" then
                put(it.key, d == true)
                table.insert(settings, {type = "toggle", key = it.key, label = it.label, set = function() shApply() end})
            elseif it.kind == "slider" then
                local sc = it.scale or 1
                put(it.key, math.clamp(math.floor((tonumber(d) or 0) * sc + 0.5), it.min, it.max))
                local fmtstr = it.fmt or "%d"
                table.insert(settings, {type = "slider", key = it.key, label = it.label, min = it.min, max = it.max, step = it.step or 1,
                    set = function() shApply() end,
                    fmt = function(v)
                        local x = v / sc
                        if string.find(fmtstr, "%d", 1, true) then x = math.floor(x + 0.5) end
                        return string.format(fmtstr, x)
                    end})
            elseif it.kind == "color" then
                local c = typeof(d) == "Color3" and d or Color3.new(1, 1, 1)
                put(it.key .. "_r", math.floor(c.R * 255 + 0.5))
                put(it.key .. "_g", math.floor(c.G * 255 + 0.5))
                put(it.key .. "_b", math.floor(c.B * 255 + 0.5))
                table.insert(settings, {type = "color", label = it.label, keys = {it.key .. "_r", it.key .. "_g", it.key .. "_b"}, set = function() shApply() end})
            elseif it.kind == "cycle" then
                put(it.key, table.find(it.options, d) or 1)
                table.insert(settings, {type = "cycle", key = it.key, label = it.label, options = it.options, set = function() end})
            end
            table.insert(shMain.specs, it)
        end
        for _, st in ipairs(settings) do table.insert(shMain.settings, st) end
    end

    -- config loading must know every key added above (addMod only knew the first four)
    shMain.setOpts = function(o)
        if type(o) == "table" then
            for k, v in pairs(shMain.defOpts) do
                if type(o[k]) == type(v) then shMain.opts[k] = o[k] end
            end
        end
        if shMain.refresh then pcall(shMain.refresh) end
        if selected == shMain then buildOpts(shMain) end
    end

