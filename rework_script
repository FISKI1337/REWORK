    -- smooth drag: the frame eases to the target, position is always tracked in plain offsets
    local hudPos = {}
    UIAPI.hudGet = function()
        local d = {}
        for id, h in pairs(hudPos) do d[id] = {x = math.floor(h.get().X + 0.5), y = math.floor(h.get().Y + 0.5)} end
        return d
    end
    UIAPI.hudSet = function(d)
        if type(d) ~= "table" then return end
        for id, h in pairs(hudPos) do
            local p = d[id]
            if type(p) == "table" and tonumber(p.x) and tonumber(p.y) then h.set(tonumber(p.x), tonumber(p.y)) end
        end
    end
    local function makeDraggable(frame, startX, startY, id)
        local target = Vector2.new(startX, startY)
        local cur = target
        if id then
            hudPos[id] = {
                get = function() return target end,
                set = function(x, y)
                    local sz = gui.AbsoluteSize
                    target = Vector2.new(
                        math.clamp(x, 0, math.max(sz.X - frame.AbsoluteSize.X, 0)),
                        math.clamp(y, 0, math.max(sz.Y - frame.AbsoluteSize.Y, 0)))
                end,
            }
        end
        local dragging, startMouse, startTarget = false, Vector2.zero, target
        frame.Position = UDim2.fromOffset(cur.X, cur.Y)
        frame.Active = true
        bindDrag(frame, function(p)
            dragging = true
            startMouse = p
            startTarget = target
        end, function(p)
            if not dragging then return end
            local sz = gui.AbsoluteSize
            local d = p - startMouse
            target = Vector2.new(
                math.clamp(startTarget.X + d.X, 0, math.max(sz.X - frame.AbsoluteSize.X, 0)),
                math.clamp(startTarget.Y + d.Y, 0, math.max(sz.Y - frame.AbsoluteSize.Y, 0)))
        end)
        table.insert(conns, UIS.InputEnded:Connect(function(i)
            if isPress(i) then dragging = false end
        end))
        table.insert(conns, RunService.RenderStepped:Connect(function(dt)
            if cur ~= target then
                -- frame-rate independent exponential smoothing, sub-pixel positions (no stepping)
                cur = cur:Lerp(target, 1 - math.exp(-dt * 9))
                if (cur - target).Magnitude < 0.05 then cur = target end
                frame.Position = UDim2.fromOffset(cur.X, cur.Y)
            end
        end))
