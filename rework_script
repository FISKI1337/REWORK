local WGKeywords = { "pistol", "gun", "knife", "glock", "revolver", "пистолет", "нож" }
local WGModeByName = {
        None = 1,
        Neon = 2,
        ForceField = 3,
}

local WGCurrentTool = nil
local WGHighlight = nil
local WGLight = nil
local WGOriginals, WGParts = {}, {}
local WGCharConns = {}

local function wg_is_weapon(Tool)
        local N = Tool.Name:lower()
        for _, K in ipairs(WGKeywords) do
                if N:find(K, 1, true) then
                        return true
                end
        end
        return false
end

local function wg_pulse(T, S)
        return (math.sin(T * S) + 1) / 2
end

local function wg_clear_effects()
        if WGHighlight then
                WGHighlight:Destroy()
                WGHighlight = nil
        end
        if WGLight then
                WGLight:Destroy()
                WGLight = nil
        end
        for Part, O in pairs(WGOriginals) do
                if Part and Part.Parent then
                        Part.Color = O.Color
                        Part.Material = O.Material
                        Part.Reflectance = O.Reflectance
                end
        end
        WGOriginals, WGParts = {}, {}
end

local function wg_apply_effects(Tool)
        wg_clear_effects()
        if not Tool or not WGConfig.Enabled then
                return
        end

        for _, D in ipairs(Tool:GetDescendants()) do
                if D:IsA("BasePart") and D.Transparency < 1 then
                        WGOriginals[D] = { Color = D.Color, Material = D.Material, Reflectance = D.Reflectance }
                        table.insert(WGParts, D)
                end
        end

        if WGConfig.Outline then
                WGHighlight = Instance.new("Highlight")
                WGHighlight.Adornee = Tool
                WGHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                WGHighlight.FillTransparency = 1
                WGHighlight.OutlineTransparency = 0
                WGHighlight.OutlineColor = WGConfig.Color
                WGHighlight.Parent = Tool
        end

        local Mode = WGModeByName[WGConfig.Mode] or 1
        if Mode > 1 then
                local Mat = (Mode == 2) and Enum.Material.Neon or Enum.Material.ForceField
                for _, P in ipairs(WGParts) do
                        P.Material = Mat
                        P.Color = WGConfig.Color
                        P.Reflectance = 0
                end
                local Handle = Tool:FindFirstChild("Handle") or WGParts[1]
                if Handle then
                        WGLight = Instance.new("PointLight")
                        WGLight.Color = WGConfig.Color
                        WGLight.Brightness = 2
                        WGLight.Range = 9
                        WGLight.Parent = Handle
                end
        end
end

local function wg_set_tool(Tool)
        if Tool and wg_is_weapon(Tool) then
                WGCurrentTool = Tool
        else
                WGCurrentTool = nil
        end
        wg_apply_effects(WGCurrentTool)
end

local function wg_bind_character(Char)
        WGCurrentTool = nil
        wg_clear_effects()
        for _, C in ipairs(WGCharConns) do
                pcall(function()
                        C:Disconnect()
                end)
        end
        WGCharConns = {}
        table.insert(WGCharConns, Char.ChildAdded:Connect(function(C)
                if C:IsA("Tool") then
                        wg_set_tool(C)
                end
        end))
        table.insert(WGCharConns, Char.ChildRemoved:Connect(function(C)
                if C == WGCurrentTool then
                        wg_set_tool(nil)
                end
        end))
        local T = Char:FindFirstChildOfClass("Tool")
        if T then
                wg_set_tool(T)
        end
end

