						osdLabels.spd.Text = ("%d km/h"):format(math.floor(velocity.Magnitude * 0.28 * 3.6))
					end
					camCf = camCf:Lerp(camGoal, math.min(dt * (fpView and 25 or 12), 1))
					cam.CFrame = camCf
					local pipTarget, bestEta
					for _, e in ipairs(getTargets(false, pos, true)) do
						local th = alive(e.p)
